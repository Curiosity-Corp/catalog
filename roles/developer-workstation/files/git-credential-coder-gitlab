#!/usr/bin/env bash
# git-credential-coder-gitlab
# -----------------------------------------------------------------------------
# Git credential helper for Coder workspaces. Mints a fresh OAuth token from
# `coder external-auth access-token gitlab` at request time and emits it as
# `username=oauth2 / password=<token>` so `git push/pull` over HTTPS works
# without a long-lived Personal Access Token.
#
# Wired up via /etc/gitconfig (or ~/.gitconfig) on workspace profile machines:
#
#     [credential "https://git.developerdojo.org"]
#         helper =
#         helper = !/usr/local/bin/git-credential-coder-gitlab
#
# The leading empty `helper =` resets any inherited helpers so this is the
# sole credential source for the host. On laptops the catalog wires the same
# section to `!glab auth git-credential` instead.
#
# Behavior: only handles `get`. Exits silently if the `coder` CLI is missing
# or the user has not yet completed the OAuth handshake at
# https://coder.developerdojo.org/external-auth/gitlab — git then falls
# through to the next configured helper.
#
# Owned by Curiosity-Corp/catalog (roles/developer-workstation).
# -----------------------------------------------------------------------------
set -eu

case ${1:-} in
    get)
        command -v coder >/dev/null || exit 0
        TOK=$(coder external-auth access-token gitlab 2>/dev/null) || exit 0
        [ -n "$TOK" ] || exit 0
        printf 'username=oauth2\npassword=%s\n' "$TOK"
        ;;
    *)
        # store / erase — no-op (token comes fresh from Coder, never cached)
        :
        ;;
esac
