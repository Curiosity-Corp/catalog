# Managed by the curiosity workstation role (streamstack task group).
[Unit]
Description=StreamStack loopback cameras (camera bridge and the program camera)
After=systemd-modules-load.service systemd-udevd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/curiosity-streamstack-loopback

[Install]
WantedBy=multi-user.target
