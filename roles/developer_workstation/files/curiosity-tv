WOL_PORT = 9
REMOTE_NAME = "Curiosity DeskMeet"  # the name the TV already trusts
KEY_VAULT = "omlab-secrets"
KEY_VAULT_SECRET = "deskmeet-samsung-tv-ws-token"
DEFAULT_TIMEOUT = 10.0
BROWSER_APP_ID = "org.tizen.browser"

# Well-known Tizen app ids. `curiosity-tv apps` lists what this TV has installed.
APP_ALIASES: dict[str, str] = {
    "youtube": "111299001912",
    "netflix": "3201907018807",
    "browser": BROWSER_APP_ID,
    "internet": BROWSER_APP_ID,
    "plex": "3201512006963",
    "prime": "3201910019365",
    "primevideo": "3201910019365",
    "amazon": "3201910019365",
    "disney": "3201901017640",
    "disneyplus": "3201901017640",
    "hulu": "3201601007625",
    "spotify": "3201606009684",
