 	if (max_frl_bw <= 0)
 		return -EINVAL;
 
 	max_frl_bw_mask = intel_dp_pcon_set_frl_mask(max_frl_bw);
 	drm_dbg(display->drm, "MAX_FRL_BW_MASK = %u\n", max_frl_bw_mask);
 
-	if (intel_dp_pcon_is_frl_trained(intel_dp, max_frl_bw_mask, &frl_trained_mask))
+	/*
+	 * A link already trained above the i915.pcon_max_frl_gbps cap (by the
+	 * PCON on its own, or before the cap was set) must be retrained, not kept.
+	 */
+	if (intel_dp_pcon_is_frl_trained(intel_dp, max_frl_bw_mask, &frl_trained_mask) &&
+	    !(frl_cap_gbps && frl_trained_mask > max_frl_bw_mask))
 		goto frl_trained;
 
 	ret = drm_dp_pcon_frl_prepare(&intel_dp->aux, false);
