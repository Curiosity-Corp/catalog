 	u8 max_frl_bw_mask = 0, frl_trained_mask;
 	bool is_active;
 
@@ -4016,13 +4155,26 @@ static int intel_dp_pcon_start_frl_train
 
 	max_frl_bw = min(max_edid_frl_bw, max_pcon_frl_bw);
 
