+	if (frl_cap_gbps && max_frl_bw > 0) {
+		drm_dbg(display->drm,
+			"FRL rate cap (i915.pcon_max_frl_gbps=%d) = %d Gbps, training at %d Gbps\n",
+			pcon_max_frl_gbps, frl_cap_gbps, min(max_frl_bw, frl_cap_gbps));
+		max_frl_bw = min(max_frl_bw, frl_cap_gbps);
