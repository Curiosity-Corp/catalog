+		return MODE_OK;
+
 	tmds_clock = intel_hdmi_tmds_clock(clock, bpc, sink_format);
 
 	min_tmds_clock = intel_dp->dfp.min_tmds_clock;
@@ -2715,6 +2836,17 @@ intel_dp_compute_config_limits(struct in
