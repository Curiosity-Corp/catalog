def teardown_interface(cfg: Config) -> None:
    """Remove the tunnel interface wherever it is; the namespace stays closed."""
    unpublish_port()  # the old port is only valid on the old tunnel
    if (NETNS_RUN / cfg.netns).exists():
        ip_ns(cfg, "link", "del", cfg.interface, check=False)
    run(["ip", "link", "del", cfg.interface], check=False)


def generate_keypair() -> tuple[str, str]:
    private = run(["wg", "genkey"]).stdout.strip()
    public = run(["wg", "pubkey"], input_text=private + "\n").stdout.strip()
    if not _valid_wg_key(private) or not _valid_wg_key(public):
        raise TunnelError("wg produced an invalid key pair")
    return private, public


def wait_for_handshake(cfg: Config, dns: Sequence[str], seconds: int | None = None) -> None:
    if seconds is None:
        seconds = int(os.environ.get("CURIOSITY_PIA_HANDSHAKE_WAIT", "20"))
    deadline = time.monotonic() + seconds
    nudged = False
    while time.monotonic() < deadline:
        if handshake_age(cfg) is not None:
            return
        if not nudged and time.monotonic() > deadline - seconds + 5:
            # Persistent keepalive normally starts the handshake; a probe is a fallback.
            exec_ns(cfg, ["ping", "-c", "1", "-W", "2", dns[0]], check=False)
            nudged = True
        time.sleep(1)
    raise TunnelError(f"no WireGuard handshake within {seconds}s")


def up(cfg: Config) -> None:
    """Build the tunnel; with port forwarding, move on from a server whose API is dead."""
    attempts = PF_SERVER_ATTEMPTS if cfg.port_forward else 1
    for attempt in range(1, attempts + 1):
        token, server = bring_up(cfg)
        if not cfg.port_forward:
            return
        persist_json(last_server_path(), {"server_cn": server.cn, "region": server.region_id})
        try:
            log(f"forwarded port {refresh_port(cfg, lambda: token)} bound")
            return
        except PortForwardUnreachable as exc:
            mark_bad_server(server.cn)
            if attempt == attempts:
                # The tunnel itself works; the bind timer keeps trying.
                log(f"warning: port forwarding is not bound yet: {exc}")
                return
            log(f"{server.cn} has no reachable port forwarding API ({exc}); trying another server")
        except TunnelError as exc:
            log(f"warning: port forwarding is not bound yet: {exc}")
            return


def bring_up(cfg: Config) -> tuple[str, Server]:
    """One tunnel build: (PIA token, the server it registered with)."""
    ensure_netns(cfg)
    username, password = read_login(cfg.login_file)
    token = get_token(username, password)
    servers = fetch_servers()
    last = read_json(last_server_path()) if cfg.port_forward else None
    prefer = last.get("server_cn") if last else None
    server = choose_server(
        servers,
        cfg.region,
        port_forward=cfg.port_forward,
        prefer_cn=prefer if isinstance(prefer, str) else None,
        exclude=bad_servers() if cfg.port_forward else (),
    )
    private, public = generate_keypair()
    reg = add_key(cfg, token, public, server)
    log(f"registered with {server.region_name or server.region_id} ({server.cn})")

    # Only now replace the running tunnel: a failed API call must not drop a
    # working one. The namespace stays closed in the gap.
    teardown_interface(cfg)
    write_netns_files(cfg, reg.dns)
    try:
        run(["ip", "link", "add", cfg.interface, "type", "wireguard"])
        run(
            ["wg", "set", cfg.interface,
             "private-key", "/dev/stdin",
             "peer", reg.server_key,
             "endpoint", f"{reg.server_ip}:{reg.server_port}",
             "allowed-ips", "0.0.0.0/0",
             "persistent-keepalive", str(cfg.keepalive)],
            input_text=private + "\n",
        )
        run(["ip", "link", "set", cfg.interface, "netns", cfg.netns])
        ip_ns(cfg, "addr", "add", f"{reg.peer_ip}/32", "dev", cfg.interface)
        ip_ns(cfg, "link", "set", cfg.interface, "mtu", str(cfg.mtu), "up")
        ip_ns(cfg, "route", "replace", "default", "dev", cfg.interface)
        wait_for_handshake(cfg, reg.dns)
    except TunnelError:
        teardown_interface(cfg)
        raise
    atomic_write(
        state_path(),
        json.dumps(
            {
                "established_at": int(time.time()),
                "region": server.region_id,
                "region_name": server.region_name,
                "server_ip": reg.server_ip,
                "server_cn": server.cn,
                "server_vip": reg.server_vip,
                "peer_ip": reg.peer_ip,
                "dns": list(reg.dns),
                "interface": cfg.interface,
                "netns": cfg.netns,
            },
            indent=2,
        )
        + "\n",
        0o644,
    )
    log(f"tunnel up: peer {reg.peer_ip}, dns {', '.join(reg.dns)}")
    return token, server


def down(cfg: Config, destroy: bool) -> None:
    teardown_interface(cfg)
    state_path().unlink(missing_ok=True)
    if destroy:
        run(["ip", "netns", "del", cfg.netns], check=False)
        for name in ("resolv.conf", "nsswitch.conf"):
            (netns_files_dir(cfg) / name).unlink(missing_ok=True)
        log(f"removed network namespace {cfg.netns}")
    else:
        log("tunnel removed; the namespace stays closed (no network inside it)")


def ensure(cfg: Config, retries: int) -> None:
    healthy, reason = health(cfg)
    if healthy:
        log(f"tunnel healthy ({reason})")
        return
    log(f"rebuilding tunnel: {reason}")
    delay = 5
    for attempt in range(1, retries + 1):
        try:
            with Lock():
                up(cfg)
            return
        except TunnelError as exc:
            log(f"attempt {attempt}/{retries} failed: {exc}")
            if attempt == retries:
                raise
            time.sleep(delay)
            delay = min(delay * 2, 60)


def bind(cfg: Config) -> None:
    """Keep PIA's port binding alive (it lapses after about 15 minutes)."""
    if not cfg.port_forward:
        log("port forwarding is off (port_forward is false); nothing to bind")
        return
    healthy, reason = health(cfg)
    if not healthy:
        log(f"not binding a port while the tunnel is down ({reason}); the watchdog rebuilds it")
        return
    with Lock():
        try:
            port = refresh_port(cfg, lambda: get_token(*read_login(cfg.login_file)))
        except PortForwardUnreachable as exc:
            cn, _vip = pf_target(cfg)
            mark_bad_server(cn)
            log(f"{cn} has no reachable port forwarding API ({exc}); moving the tunnel to another server")
            up(cfg)
            return
    log(f"forwarded port {port} bound")


def status(cfg: Config) -> int:
    healthy, reason = health(cfg)
    state = read_state() or {}

    def row(label: str, value: object) -> None:
        print(f"{label + ':':<16}{value}")

    row("namespace", f"{cfg.netns} ({'present' if (NETNS_RUN / cfg.netns).exists() else 'absent'})")
    row("connected", f"{'yes' if healthy else 'no'} ({reason})")
    for key in ("region_name", "server_cn", "server_ip", "peer_ip", "dns", "established_at"):
        if key in state:
            row(key, state[key])
    if cfg.port_forward:
        try:
            port = int(port_file().read_text().strip())
            age = int(max(0.0, time.time() - port_file().stat().st_mtime))
            row("forwarded_port", f"{port} (bound {age}s ago)")
        except (FileNotFoundError, ValueError, OSError):
            row("forwarded_port", "none (not bound; the bind timer retries)")
    return 0 if healthy else 1


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("up", help="register with PIA and (re)build the tunnel")
    p_down = sub.add_parser("down", help="remove the tunnel")
    p_down.add_argument("--destroy", action="store_true", help="also delete the namespace")
    p_ensure = sub.add_parser("ensure", help="rebuild only when missing, stale or too old")
    p_ensure.add_argument("--retries", type=int, default=1)
    sub.add_parser("needs-renewal", help="exit 0 when the tunnel must be rebuilt")
    sub.add_parser("bind", help="(re)acquire and re-bind the forwarded port")
    sub.add_parser("status", help="print the tunnel state")
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    if os.geteuid() != 0 and "CURIOSITY_PIA_ALLOW_NON_ROOT" not in os.environ:
        print("curiosity-pia-tunnel: must run as root", file=sys.stderr)
        return 2
    try:
        cfg = Config.load()
        if args.command == "up":
            with Lock():
                up(cfg)
        elif args.command == "down":
            with Lock():
                down(cfg, args.destroy)
        elif args.command == "ensure":
            ensure(cfg, max(1, args.retries))
        elif args.command == "needs-renewal":
            healthy, reason = health(cfg)
            log(f"{'healthy' if healthy else 'needs renewal'}: {reason}")
            return 1 if healthy else 0
        elif args.command == "bind":
            bind(cfg)
        elif args.command == "status":
            return status(cfg)
    except TunnelError as exc:
        print(f"curiosity-pia-tunnel: error: {exc}", file=sys.stderr)
        # ExecCondition= treats 1-254 as "skip quietly"; 255 makes the watchdog fail loudly.
        return 255 if args.command == "needs-renewal" else 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
