#!/usr/bin/python3 -I
"""Restart the StreamStack Console only when no call can be using it (catalog#137).

Managed by the curiosity workstation role (streamstack task group).

An ansible-pull run that replaces the StreamStack package restarts the Console
so it runs the new code. The Console hosts the native engine that feeds the
program camera and the StreamStack Mic voice chain, so a restart during a live
Teams, Zoom or Meet call freezes the camera and drops the microphone for that
call. This helper asks StreamStack's own evidence whether a call may be on (the
apps holding a camera node open, and the programs capturing audio, through
streamstack.camerapublish, which already refuses a WirePlumber restart in a
call), so there is one definition of "in a call":

  curiosity-streamstack-console-restart            ansible-pull, after a package replacement
  curiosity-streamstack-console-restart --pending  streamstack-console-restart-pending.timer

Nothing may be using it: restart the Console now (start it when it is not
running) and clear the pending marker. A call may be on: leave
$XDG_RUNTIME_DIR/streamstack/console-restart-pending, start the pending timer
and exit 3. The timer runs --pending every minute and restarts the Console once
the call is over, then stops itself. The marker lives in the runtime directory,
so a logout (which stops the Console) drops it: the next login runs the new code.

Run as the Console's user, with XDG_RUNTIME_DIR and HOME set.
"""

from __future__ import annotations

import os
import subprocess
import sys
from collections.abc import Callable, Sequence
from pathlib import Path

LIB = Path(os.environ.get("STREAMSTACK_LIB", "/usr/local/lib/streamstack"))
DONE, FAILED, BUSY, USAGE = 0, 1, 3, 2
CONSOLE = "streamstack-console.service"
TIMER = "streamstack-console-restart-pending.timer"
DEVICE_KEYS = ("STREAMSTACK_CAMERA_DEVICE", "STREAMSTACK_PROGRAM_DEVICE")

Run = Callable[..., subprocess.CompletedProcess]


def systemctl(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["systemctl", "--user", *args], capture_output=True, text=True, timeout=120, check=False)


def marker_path() -> Path:
    runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    if not runtime:
        raise SystemExit("curiosity-streamstack-console-restart: XDG_RUNTIME_DIR is not set; run it as the Console's user")
    return Path(runtime) / "streamstack" / "console-restart-pending"


def call_reason(
    readers: Callable[[str], list[str]] | None = None,
    streams: Callable[[], list[str] | None] | None = None,
) -> str:
    """StreamStack's sentence naming what may be a call; empty when nothing is."""
    if str(LIB) not in sys.path:
        sys.path.insert(0, str(LIB))
    from streamstack import camerapublish, config

    try:
        cfg = config.load_settings()
    except (OSError, ValueError) as exc:
        print(f"curiosity-streamstack-console-restart: cannot read the StreamStack settings ({exc}); using the defaults")
        cfg = dict(config.DEFAULTS)
    readers = readers or camerapublish.camera_readers
    streams = streams or camerapublish.capture_streams
    holding = [app for key in DEVICE_KEYS if cfg.get(key) for app in readers(cfg[key])]
    return camerapublish.busy_reason(holding, streams())


def _detail(done: subprocess.CompletedProcess) -> str:
    return (done.stderr or done.stdout or f"exit {done.returncode}").strip()


def main(
    argv: Sequence[str] | None = None,
    *,
    run: Run = systemctl,
    reason: Callable[[], str] = call_reason,
    marker: Callable[[], Path] = marker_path,
) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if args not in ([], ["--pending"]):
        print("usage: curiosity-streamstack-console-restart [--pending]", file=sys.stderr)
        return USAGE
    pending = args == ["--pending"]
    path = marker()

    if pending and not path.exists():
        run("stop", TIMER)
        return DONE

    if run("is-active", "--quiet", CONSOLE).returncode != 0:
        # Not running: nothing old to replace and no call can be using it.
        path.unlink(missing_ok=True)
        if pending:
            run("stop", TIMER)
            print("The StreamStack Console is not running; its next start runs the new release.")
            return DONE
        done = run("start", CONSOLE)
        if done.returncode != 0:
            print(f"Could not start the StreamStack Console: {_detail(done)}", file=sys.stderr)
            return FAILED
        print("Started the StreamStack Console.")
        return DONE

    why = reason()
    if why:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(why + "\n")
        if not pending:
            started = run("start", TIMER)
            if started.returncode != 0:
                print(f"Could not start {TIMER}: {_detail(started)}", file=sys.stderr)
                return FAILED
        print(f"Not restarting the StreamStack Console now: {why}. It restarts once the call is over.")
        return BUSY

    done = run("restart", CONSOLE)
    if done.returncode != 0:
        # The marker stays (or is left now), so the timer tries again.
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(f"restart failed: {_detail(done)}\n")
        print(f"Could not restart the StreamStack Console: {_detail(done)}", file=sys.stderr)
        return FAILED
    path.unlink(missing_ok=True)
    run("stop", TIMER)
    print("Restarted the StreamStack Console on the new release.")
    return DONE


if __name__ == "__main__":
    sys.exit(main())
