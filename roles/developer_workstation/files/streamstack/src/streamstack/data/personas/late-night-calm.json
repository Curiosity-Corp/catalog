{
  "schema": 1,
  "id": "late-night-calm",
  "name": "Late-night calm",
  "tagline": "Low, warm and intimate",
  "description": "A hushed, cosy feel for evenings and after midnight: dimmer, warmer, softer contrast, a close deep voice.",
  "mood": [
    "calm",
    "intimate",
    "warm",
    "relaxed",
    "low-key"
  ],
