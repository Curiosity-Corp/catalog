#!/usr/bin/env bash
# Nightly cleanup for the hhtest test-bed account. Runs AS that account (never
# root), so it can only ever delete what that account owns. Removes regular
# files and symlinks older than N days under the directories given (the service passes ~/work and /tmp), then prunes the
# empty directories they leave behind. Sockets (a live tmux server's) and
# anything newer than the age are left alone. Never follows symlinks.
#
# Go makes its module cache read-only (directories 0555, files 0444), and
# unlinking a file needs write permission on its DIRECTORY, so a plain find
# -delete failed with "Permission denied" on ~/work/gomodcache and the nightly
# unit ended up failed. Before deleting, the owner's write permission is given
# back on the directories this account owns under each root. The chmod pass
# only matches real directories (-type d, symlinks are never followed), stays
# on the root's filesystem (-xdev), skips the root itself and anything owned by
# another uid, and touches directory modes only, never file contents.
set -euo pipefail

usage="usage: hhtest-cleanup <age-days> <dir>..."
age_days="${1:?$usage}"
shift
[[ $# -ge 1 ]] || { echo "hhtest-cleanup: $usage" >&2; exit 2; }

case "$age_days" in
  '' | *[!0-9]* | 0)
    echo "hhtest-cleanup: age must be a positive integer, got '$age_days'" >&2
    exit 2
    ;;
esac

me="$(id -u)"
if [[ "$me" -eq 0 ]]; then
  echo "hhtest-cleanup: refusing to run as root" >&2
  exit 2
fi

# Directories another uid owns (systemd-private-*, other users' tmux and socket
# directories under /tmp) can neither be searched nor are ours to clean: they are
# pruned, so find never descends into them and never reports "Permission denied"
# for them. Everything below acts only on entries owned by this account.
for root in "$@"; do
  [[ -d "$root" ]] || continue
  if ! find "$root" -xdev -mindepth 1 \( -type d ! -uid "$me" -prune \) -o \
    \( -type d -uid "$me" ! -perm -u=rwx -exec chmod u+rwx -- {} + \); then
    echo "hhtest-cleanup: could not restore owner permissions under $root; deleting what is possible" >&2
  fi
  find "$root" -xdev -mindepth 1 \( -type d ! -uid "$me" -prune \) -o \
    \( -uid "$me" \( -type f -o -type l \) -mtime "+$age_days" -exec rm -f -- {} + \)
  find "$root" -xdev -mindepth 1 \( -type d ! -uid "$me" -prune \) -o \
    \( -uid "$me" -type d -empty -mmin +60 -exec rmdir -- {} + \)
done
