#!/bin/sh
# Re-apply the declared display layout when a screen or touch panel comes or goes.
# Managed by Ansible.
#
# Started by the Openbox autostart, once per X display, as the session user.
# Openbox has no RandR policy of its own, so a monitor that asserts hot-plug
# after X started (dm313red's second Sceptre stayed dark for a whole boot,
# Curiosity-Corp/catalog-internal#24) or a touch panel plugged in later would
# otherwise stay unlit or unmapped until the next login.
#
# Every CURIOSITY_DISPLAY_HOTPLUG_INTERVAL seconds (default 2) it reads the
# connector status files under /sys/class/drm (reading them never triggers a
# probe) and which declared touch devices (/etc/curiosity/touch-outputs) are
# in /proc/bus/input/devices. When that signature changes and then holds for
# one more interval, it runs curiosity-display-setup once. Its own modesets do
# not change connector status, so it cannot loop. It exits when the X display
# stops answering, and a new start on the same display replaces the old one.

prog=curiosity-display-hotplug
setup=${CURIOSITY_DISPLAY_SETUP:-curiosity-display-setup}
touch_config=${CURIOSITY_TOUCH_OUTPUTS:-/etc/curiosity/touch-outputs}
drm_root=${CURIOSITY_DRM_ROOT:-/sys/class/drm}
input_devices=${CURIOSITY_INPUT_DEVICES:-/proc/bus/input/devices}
interval=${CURIOSITY_DISPLAY_HOTPLUG_INTERVAL:-2}
state_dir=${XDG_RUNTIME_DIR:-/tmp}
pid_file="$state_dir/curiosity-display-hotplug-$(printf '%s' "${DISPLAY:-none}" | tr -c 'A-Za-z0-9_.-' '_').pid"

warn() {
    printf '%s: %s\n' "$prog" "$*" >&2
}

display_alive() {
    xset q >/dev/null 2>&1
}

signature() {
    for status in "$drm_root"/*/status; do
        [ -r "$status" ] || continue
        printf '%s %s\n' "$status" "$(cat "$status" 2>/dev/null)"
    done
    if [ -r "$touch_config" ] && [ -r "$input_devices" ]; then
        awk '
            NR == FNR {
                line = $0
                sub(/#.*/, "", line)
                if (sub(/^[[:space:]]*[^[:space:]]+[[:space:]]+/, "", line)) {
                    sub(/[[:space:]]+$/, "", line)
                    if (line != "") wanted[line] = 1
                }
                next
            }
            /^N: Name="/ {
                name = $0
                sub(/^N: Name="/, "", name)
                sub(/"$/, "", name)
                if (name in wanted) print "touch " name
            }' "$touch_config" "$input_devices" | sort
    fi
}

# One watcher per display: stop the one a previous autostart run left behind.
if [ -r "$pid_file" ]; then
    previous=$(cat "$pid_file" 2>/dev/null)
    case "$previous" in
        "" | *[!0-9]*) ;;
        *)
            if [ "$previous" != "$$" ] && grep -q curiosity-display-hotplug "/proc/$previous/cmdline" 2>/dev/null; then
                kill "$previous" 2>/dev/null || true
            fi
            ;;
    esac
fi
if ! printf '%s\n' "$$" >"$pid_file"; then
    warn "cannot write $pid_file; a second watcher on this display will not replace this one"
fi
# Remove the pid file only while it is still ours: a replacing watcher may
# already have written its own.
# shellcheck disable=SC2329 # invoked by the EXIT trap
release_pid_file() {
    [ "$(cat "$pid_file" 2>/dev/null)" = "$$" ] && rm -f "$pid_file"
}
trap release_pid_file EXIT
trap 'exit 0' INT TERM HUP

current=$(signature)
while display_alive; do
    sleep "$interval"
    next=$(signature)
    [ "$next" = "$current" ] && continue
    # Let a plug settle: act once the signature holds for a whole interval.
    sleep "$interval"
    settled=$(signature)
    [ "$settled" = "$next" ] || continue
    current=$settled
    display_alive || break
    "$setup" || warn "$setup failed; the layout was not re-applied"
done
exit 0
