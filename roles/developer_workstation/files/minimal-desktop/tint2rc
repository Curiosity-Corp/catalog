# Minimal tint2 panel for Openbox

# Panel
panel_items = LTSC
panel_size = 100% 28
panel_margin = 0 0
panel_padding = 4 0 4
panel_background_id = 1
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
panel_dock = 0
autohide = 0
strut_policy = follow_size

# Backgrounds
# ID 1 - Panel background
rounded = 0
border_width = 0
border_sides =
background_color = #1a1a2e 90
border_color = #000000 0
background_color_hover = #1a1a2e 90
border_color_hover = #000000 0

# ID 2 - Active task background
rounded = 3
border_width = 1
border_sides = TBLR
background_color = #3a3a5e 80
border_color = #5a5a8e 60
background_color_hover = #4a4a6e 80
border_color_hover = #6a6a9e 60

# ID 3 - Inactive task background
rounded = 3
border_width = 0
border_sides =
background_color = #000000 0
border_color = #000000 0
background_color_hover = #2a2a4e 60
border_color_hover = #000000 0

# Taskbar
taskbar_mode = single_desktop
taskbar_hide_if_empty = 0
taskbar_padding = 2 2 2
taskbar_background_id = 0
taskbar_active_background_id = 0
taskbar_name = 1
taskbar_name_padding = 4 2
taskbar_name_active_background_id = 0
taskbar_name_font = Sans Bold 9
taskbar_name_active_color = #cccccc 100
taskbar_name_color = #666666 100

# Tasks
task_text = 1
task_icon = 1
task_centered = 0
task_tooltip = 1
task_maximum_size = 200 28
task_padding = 4 2 4
task_font = Sans 9
task_font_color = #cccccc 80
task_active_font_color = #ffffff 100
task_icon_size = 16
task_active_background_id = 2
task_background_id = 3
urgent_nb_of_blink = 5

# System tray
systray_padding = 4 2 4
systray_background_id = 0
systray_sort = ascending
systray_icon_size = 18
systray_icon_asb = 100 0 0

# Clock
time1_format = %H:%M
time1_font = Sans Bold 9
time2_format = %a %d %b
time2_font = Sans 8
clock_font_color = #cccccc 100
clock_padding = 6 0
clock_background_id = 0
clock_tooltip = %A %d %B %Y
clock_lclick_command =
clock_rclick_command =

# Launcher
launcher_padding = 2 2 2
launcher_background_id = 0
launcher_icon_size = 20
launcher_icon_theme = hicolor
launcher_item_app = firefox.desktop
launcher_item_app = lxterminal.desktop
launcher_item_app = pcmanfm.desktop
