#!/bin/sh
# LightDM X server wrapper (managed by Ansible).
#
# LightDM starts its X server with -novtswitch, which disables Ctrl+Alt+Fn
# switching while the greeter or an autologin session is active. Drop that one
# argument and hand everything else to the real server unchanged.
for arg in "$@"; do
    shift
    [ "$arg" = "-novtswitch" ] || set -- "$@" "$arg"
done
exec /usr/bin/X "$@"
