#!/bin/sh
# Pick one output, drive it at its best mode, and make it primary.
# Managed by Ansible.
#
# Preferences come from /etc/curiosity/display-outputs (override with
# CURIOSITY_DISPLAY_OUTPUTS): one xrandr output name per line, blank lines and
# '#' comments ignored. The first preferred output that is connected wins;
# otherwise the first connected output is used. Its largest mode is applied at
# the highest refresh rate that mode offers, and the output becomes primary.
# When the output marks a preferred (+) mode, only modes with that mode's aspect
# ratio are candidates, so a 16:9 UHD panel is not switched to the larger DCI
# 4096x2160 (17:9) mode it also lists.
# Every other connected output is switched off only when a preferred output
# was found, so an empty or unmatched list never blanks a working screen.
#
# Runs as the LightDM display-setup-script (as root, before the greeter) and
# from the Openbox autostart (startx sessions have no display-setup hook).
# Nothing here may block a login: LightDM stops the display when its
# display-setup-script fails, so the script always exits 0 and reports anything
# it could not do on stderr.

config=${CURIOSITY_DISPLAY_OUTPUTS:-/etc/curiosity/display-outputs}
prog=curiosity-display-setup

warn() {
    printf '%s: %s\n' "$prog" "$*" >&2
}

if ! query=$(xrandr --query 2>&1); then
    warn "cannot query the display: $query"
    exit 0
fi

# One record per line: "C <output>" for a connected output,
# "M <output> <width> <height> <rate>" for each progressive mode refresh rate,
# and "P <output> <width> <height>" for a preferred (+) progressive mode. xrandr
# prints the + marker attached to a rate ("60.00*+") or as its own field.
to_records() {
    printf '%s\n' "$1" | awk '
    $2 == "connected" || $2 == "disconnected" {
        output = $1
        if ($2 == "connected") print "C", output
        next
    }
    output != "" && $1 ~ /^[0-9]+x[0-9]+$/ {
        split($1, size, "x")
        for (i = 2; i <= NF; i++) {
            if ($i ~ /\+/) print "P", output, size[1], size[2]
            rate = $i
            gsub(/[*+]/, "", rate)
            if (rate ~ /^[0-9]+(\.[0-9]+)?$/) print "M", output, size[1], size[2], rate
        }
    }'
}
records=$(to_records "$query")
connected=$(printf '%s\n' "$records" | awk '$1 == "C" { print $2 }')
if [ -z "$connected" ]; then
    warn "no connected output; leaving the display unchanged"
    exit 0
fi

target=
found_preferred=0
if [ -r "$config" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        name=$(printf '%s\n' "${line%%#*}" | tr -d '[:space:]')
        [ -n "$name" ] || continue
        case "$name" in
            *[!A-Za-z0-9_.:-]*)
                warn "ignoring invalid output name in $config: $name"
                continue
                ;;
        esac
        if printf '%s\n' "$connected" | grep -qx -- "$name"; then
            target=$name
            found_preferred=1
            break
        fi
    done <"$config"
elif [ -e "$config" ]; then
    warn "cannot read $config; using the first connected output"
fi

if [ -z "$target" ]; then
    target=$(printf '%s\n' "$connected" | head -n 1)
fi

# Optional pin (/etc/curiosity/display-guard.conf, written by the role): when the
# chosen output is the pinned one, apply exactly the pinned mode and never a
# lower one. A display that has just woken may list too few modes for a moment,
# so re-probe a few times; if the pinned mode still is not there, leave a
# working display alone rather than fall back to another resolution.
guard_conf=${CURIOSITY_DISPLAY_GUARD_CONF:-/etc/curiosity/display-guard.conf}
pinned=
if [ -r "$guard_conf" ]; then
    conf_get() { sed -n "s/^$1=//p" "$guard_conf" | head -n 1 | tr -d '[:space:]'; }
    pin_output=$(conf_get output)
    pin_mode=$(conf_get mode)
    pin_rate=$(conf_get rate)
    if [ "$pin_output" = "$target" ] && [ -n "$pin_mode" ] && [ -n "$pin_rate" ]; then
        attempt=0
        while :; do
            pinned=$(printf '%s\n' "$records" | awk -v out="$target" -v mode="$pin_mode" -v rate="$pin_rate" '
                $1 == "M" && $2 == out && ($3 "x" $4) == mode && ($5 + 0) == (rate + 0) { print mode, $5; exit }')
            [ -n "$pinned" ] && break
            attempt=$((attempt + 1))
            [ "$attempt" -gt 3 ] && break
            xrandr >/dev/null 2>&1
            sleep "${CURIOSITY_DISPLAY_RETRY_SLEEP:-2}"
            query=$(xrandr --query 2>&1) || break
            records=$(to_records "$query")
        done
        if [ -z "$pinned" ]; then
            if printf '%s\n' "$query" | grep -q '\*'; then
                warn "pinned mode $pin_mode@$pin_rate is not listed for $target; leaving the display unchanged"
                exit 0
            fi
            warn "pinned mode $pin_mode@$pin_rate is not listed for $target and nothing is active; using the best mode"
        fi
    fi
fi
best=$(printf '%s\n' "$records" | awk -v out="$target" '
    $1 == "P" && $2 == out && !pref_height {
        pref_width = $3
        pref_height = $4
    }
    $1 == "M" && $2 == out {
        n++
        width[n] = $3
        height[n] = $4
        rate[n] = $5
    }
    END {
        for (i = 1; i <= n; i++) {
            # Same aspect as the preferred mode, within 1% (1366x768 ~ 16:9).
            if (pref_height) {
                skew = width[i] * pref_height - height[i] * pref_width
                if (skew < 0) skew = -skew
                if (skew > 0.01 * height[i] * pref_width) continue
            }
            area = width[i] * height[i]
            if (area > best_area || (area == best_area && rate[i] + 0 > best_rate + 0)) {
                best_area = area
                best_width = width[i]
                best_height = height[i]
                best_rate = rate[i]
            }
        }
        if (best_area > 0) print best_width "x" best_height, best_rate
    }')

if [ -n "$pinned" ]; then
    best=$pinned
fi
if [ -n "$best" ]; then
    mode=${best% *}
    rate=${best#* }
    set -- --output "$target" --mode "$mode" --rate "$rate" --primary
else
    warn "no usable mode listed for $target; using its preferred mode"
    set -- --output "$target" --auto --primary
fi

if [ "$found_preferred" -eq 1 ]; then
    for other in $connected; do
        [ "$other" = "$target" ] || set -- "$@" --output "$other" --off
    done
fi

if ! result=$(xrandr "$@" 2>&1); then
    warn "xrandr failed for $target: $result"
    exit 0
fi

# Optional output range. /etc/curiosity/display-broadcast-rgb (override with
# CURIOSITY_DISPLAY_BROADCAST_RGB) holds one value for the xrandr "Broadcast RGB"
# property: Full, Limited 16:235 or Automatic. Intel i915 picks limited range
# for HDMI/CEA modes by default, which washes out a PC desktop on a TV. The
# property is only set when the file exists and the output has it. A failure is
# reported and never stops the login.
broadcast_config=${CURIOSITY_DISPLAY_BROADCAST_RGB:-/etc/curiosity/display-broadcast-rgb}
if [ -r "$broadcast_config" ]; then
    broadcast_value=$(sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^$/d' "$broadcast_config" | head -n 1)
    case "$broadcast_value" in
        "" | Automatic | Full | "Limited 16:235") ;;
        *)
            warn "ignoring invalid Broadcast RGB value in $broadcast_config: $broadcast_value"
            broadcast_value=
            ;;
    esac
    if [ -n "$broadcast_value" ]; then
        if properties=$(xrandr --prop 2>&1); then
            has_broadcast=$(printf '%s\n' "$properties" | awk -v out="$target" '
                $1 == out && ($2 == "connected" || $2 == "disconnected") { in_output = 1; next }
                /^[^[:space:]]/ { in_output = 0 }
                in_output && $1 == "Broadcast" && $2 == "RGB:" { found = 1 }
                END { print found ? "yes" : "no" }')
            if [ "$has_broadcast" = yes ]; then
                if ! result=$(xrandr --output "$target" --set "Broadcast RGB" "$broadcast_value" 2>&1); then
                    warn "cannot set Broadcast RGB on $target: $result"
                fi
            fi
        else
            warn "cannot query the properties of $target: $properties"
        fi
    fi
elif [ -e "$broadcast_config" ]; then
    warn "cannot read $broadcast_config; leaving Broadcast RGB alone"
fi
