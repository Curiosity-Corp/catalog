# Set cursor immediately
xsetroot -cursor_name left_ptr &

# Wallpaper (solid dark fallback)
nitrogen --restore 2>/dev/null || xsetroot -solid "#1a1a2e" &

# Compositor
picom --config ~/.config/picom/picom.conf &

# Panel
tint2 &

# Notifications
dunst &

# System tray applets
nm-applet &
volumeicon &
blueman-applet &

# Lock the current X11 session after 10 minutes of inactivity. xss-lock also
# handles logind lock requests and coordinates locking before suspend.
xset s 600 0
if command -v xss-lock >/dev/null 2>&1 && command -v i3lock >/dev/null 2>&1; then
    if ! command -v pgrep >/dev/null 2>&1 || \
       ! pgrep -u "$(id -u)" -x xss-lock >/dev/null 2>&1; then
        xss-lock --transfer-sleep-lock -- i3lock --nofork &
    fi
fi
