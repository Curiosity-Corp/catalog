# Set cursor immediately
xsetroot -cursor_name left_ptr &

# Wallpaper (solid dark fallback)
nitrogen --restore 2>/dev/null || xsetroot -solid "#1a1a2e" &

# Compositor
picom --config ~/.config/picom/picom.conf &

# Panel
tint2 &

# Notifications
dunst &

# System tray applets
nm-applet &
volumeicon &
blueman-applet &

# XScreenSaver provides a PAM conversation window: it can display each login
# prompt (including a second-factor prompt) instead of treating every keypress
# as an unexplained radial indicator. Its resource file sets a 10-minute
# timeout, blank mode, and immediate locking.
if command -v xscreensaver >/dev/null 2>&1; then
    xscreensaver --no-splash &
fi
