#!/bin/sh

# Set cursor immediately
xsetroot -cursor_name left_ptr &

# Preferred display layout. LightDM runs the same helper for its own X server;
# startx sessions (pinned VTs) have no such hook. The helper is only installed
# when minimal_desktop_display_setup_enabled is true.
if command -v curiosity-display-setup >/dev/null 2>&1; then
    curiosity-display-setup || echo "curiosity-display-setup failed; keeping the current display layout." >&2
fi

# Wallpaper: feh records the last choice in ~/.fehbg (solid dark fallback)
if [ -x "$HOME/.fehbg" ]; then
    "$HOME/.fehbg" &
else
    xsetroot -solid "#1a1a2e" &
fi

# Compositor
picom --config ~/.config/picom/picom.conf &

# Panel
tint2 &

# Notifications
dunst &

# System tray applets
nm-applet &
pasystray &
blueman-applet &

# XScreenSaver provides a PAM conversation window for password and optional
# second-factor prompts. Prefer FocusPass when installed. Replace a stock
# daemon only on this DISPLAY; never disturb another graphical session.
#
# The daemon's process name is the same for the stock and FocusPass builds.
# Process identity therefore includes the real executable's path and device /
# inode pair, plus the DISPLAY in its environment. A matching process is only
# considered live after its command helper responds on this DISPLAY.
display_xscreensaver_pids() {
    for pid in $(pgrep -x xscreensaver 2>/dev/null || true); do
        [ -r "${FOCUSPASS_PROC_ROOT:-/proc}/$pid/environ" ] || continue
        process_display=$(tr '\000' '\n' <"${FOCUSPASS_PROC_ROOT:-/proc}/$pid/environ" | sed -n 's/^DISPLAY=//p' | head -n 1)
        [ "$process_display" = "${DISPLAY:-}" ] && printf '%s\n' "$pid"
    done
}

screenlock_pid_is_alive() {
    if [ -n "${FOCUSPASS_PROCESS_ALIVE_HELPER:-}" ]; then
        "$FOCUSPASS_PROCESS_ALIVE_HELPER" "$1"
    else
        kill -0 "$1" 2>/dev/null
    fi
}

focuspass_path=/opt/focuspass-screenlock/bin/xscreensaver
focuspass_identity=$(stat -Lc '%d:%i' "$focuspass_path" 2>/dev/null || true)

focuspass_pids() {
    for pid in $(display_xscreensaver_pids); do
        process_exe=$(readlink -f "${FOCUSPASS_PROC_ROOT:-/proc}/$pid/exe" 2>/dev/null || true)
        [ "$process_exe" = "$focuspass_path" ] || continue
        [ -n "$focuspass_identity" ] || continue
        process_identity=$(stat -Lc '%d:%i' "${FOCUSPASS_PROC_ROOT:-/proc}/$pid/exe" 2>/dev/null || true)
        [ "$process_identity" = "$focuspass_identity" ] && printf '%s\n' "$pid"
    done
}

focuspass_command_responds() {
    focuspass_status=$(focuspass-screenlock-command -time 2>/dev/null) || return 1
    [ -n "$focuspass_status" ]
}

screenlock_reports_unlocked() {
    screenlock_status_lower=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    case "$screenlock_status_lower" in
        *"screen non-blanked since"*|*"screen unblanked since"*) return 0 ;;
    esac
    return 1
}

focuspass_is_healthy=false
pre_handoff_screenlock_pids=$(display_xscreensaver_pids)
focuspass_existing_pids=$(focuspass_pids)
if [ -n "$focuspass_existing_pids" ] \
    && [ "$focuspass_existing_pids" = "$pre_handoff_screenlock_pids" ] \
    && focuspass_command_responds; then
    focuspass_is_healthy=true
fi

if [ "$focuspass_is_healthy" = true ]; then
    :
elif command -v focuspass-screenlock >/dev/null 2>&1; then
    screenlock_pids=$pre_handoff_screenlock_pids
    if [ -n "$screenlock_pids" ]; then
        lock_status=''
        lock_status_rc=0
        lock_status=$(xscreensaver-command -time 2>/dev/null) || lock_status_rc=$?
        if [ "$lock_status_rc" -ne 0 ] || ! screenlock_reports_unlocked "$lock_status"; then
            echo "The existing XScreenSaver lock on ${DISPLAY:-unknown} is active or unknown; leaving it in place." >&2
            exit 1
        fi
        if ! xscreensaver-command --exit >/dev/null 2>&1; then
            echo "Could not gracefully stop the existing XScreenSaver daemon on ${DISPLAY:-unknown}." >&2
            exit 1
        fi
        still_running=true
        attempt=1
        while [ "$attempt" -le 20 ]; do
            still_running=false
            for pid in $screenlock_pids; do
                screenlock_pid_is_alive "$pid" && still_running=true
            done
            [ "$still_running" = false ] && break
            sleep 0.25
            attempt=$((attempt + 1))
        done
        if [ "$still_running" = true ]; then
            echo "XScreenSaver on ${DISPLAY:-unknown} did not exit; leaving it untouched." >&2
            exit 1
        fi
    fi
    focuspass-screenlock --no-splash &
    focuspass_started=false
    attempt=1
    while [ "$attempt" -le 20 ]; do
        if [ -n "$(focuspass_pids)" ] && focuspass_command_responds; then
            focuspass_started=true
            break
        fi
        sleep 0.25
        attempt=$((attempt + 1))
    done
    if [ "$focuspass_started" != true ]; then
        remaining_screenlock_pids=$(display_xscreensaver_pids)
        rollback_safe_to_restore=false
        if [ -z "$remaining_screenlock_pids" ]; then
            rollback_status=''
            rollback_status_rc=0
            rollback_status=$(xscreensaver-command -time 2>/dev/null) || rollback_status_rc=$?
            if [ "$rollback_status_rc" -ne 0 ] || screenlock_reports_unlocked "$rollback_status"; then
                rollback_safe_to_restore=true
            fi
        else
            rollback_status=''
            rollback_status_rc=0
            rollback_status=$(xscreensaver-command -time 2>/dev/null) || rollback_status_rc=$?
            if [ "$rollback_status_rc" -eq 0 ] && screenlock_reports_unlocked "$rollback_status"; then
                rollback_safe_to_restore=true
            fi
        fi
        if [ "$rollback_safe_to_restore" = true ]; then
            focuspass_remaining_pids=$(focuspass_pids)
            if [ -n "$focuspass_remaining_pids" ]; then
                focuspass-screenlock-command --exit >/dev/null 2>&1 || true
                attempt=1
                while [ "$attempt" -le 20 ] && [ -n "$(focuspass_pids)" ]; do
                    sleep 0.25
                    attempt=$((attempt + 1))
                done
            fi
            remaining_screenlock_pids=$(display_xscreensaver_pids)
            if [ -z "$remaining_screenlock_pids" ] && command -v xscreensaver >/dev/null 2>&1; then
                xscreensaver --no-splash &
                echo "FocusPass did not become responsive; restored stock XScreenSaver on ${DISPLAY:-unknown}." >&2
            else
                echo "FocusPass did not become responsive; another XScreenSaver process remains, so the current screen-lock state is preserved." >&2
            fi
        else
            echo "FocusPass did not become responsive; preserving the current screen-lock state." >&2
        fi
    fi
elif [ -z "$(display_xscreensaver_pids)" ] && command -v xscreensaver >/dev/null 2>&1; then
    xscreensaver --no-splash &
fi
