# Set cursor immediately
xsetroot -cursor_name left_ptr &

# Wallpaper (solid dark fallback)
nitrogen --restore 2>/dev/null || xsetroot -solid "#1a1a2e" &

# Compositor
picom --config ~/.config/picom/picom.conf &

# Panel
tint2 &

# Notifications
dunst &

# System tray applets
nm-applet &
volumeicon &
