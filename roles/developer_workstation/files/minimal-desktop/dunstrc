[global]
    font = Sans 10
    markup = full
    format = "<b>%s</b>\n%b"
    sort = yes
    indicate_hidden = yes
    alignment = left
    show_age_threshold = 30
    word_wrap = yes
    width = 300
    height = 100
    offset = 10x38
    origin = top-right
    shrink = no
    transparency = 5
    padding = 8
    horizontal_padding = 10
    frame_width = 1
    frame_color = "#4c566a"
    separator_height = 1
    separator_color = frame
    idle_threshold = 120
    monitor = 0
    follow = mouse
    icon_position = left
    max_icon_size = 32
    corner_radius = 3
    mouse_left_click = close_current
    mouse_right_click = close_all
    history_length = 20
    show_indicators = no
    stack_duplicates = true
    hide_duplicate_count = true

[urgency_low]
    background = "#1a1a2e"
    foreground = "#d8dee9"
    timeout = 4

[urgency_normal]
    background = "#1a1a2e"
    foreground = "#d8dee9"
    timeout = 8

[urgency_critical]
    background = "#bf616a"
    foreground = "#eceff4"
    frame_color = "#bf616a"
    timeout = 0
