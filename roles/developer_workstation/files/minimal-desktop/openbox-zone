#!/usr/bin/python3
"""Move the focused Openbox window into one of the AI workspace zones.

`openbox-zone <zone>` snaps the window into the zone. `openbox-zone toggle
[zone]` (default `browser`, the middle of the screen) snaps it there and
remembers where it was; running it again puts the window back exactly where it
was, including a maximized or fullscreen state.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path


MARGIN = 12
GAP = 12


ZONE_NAMES = ("agent-top", "agent-bottom", "browser", "chats", "top", "bottom")
USAGE = (
    "usage: openbox-zone {agent-top|agent-bottom|browser|chats|top|bottom}\n"
    "       openbox-zone toggle [zone]   (default zone: browser)\n"
    "       openbox-zone --list"
)
DEFAULT_TOGGLE_ZONE = "browser"
STATE_FLAGS = ("MAXIMIZED_VERT", "MAXIMIZED_HORZ", "FULLSCREEN")
TOLERANCE = 6


def run(*args: str) -> str:
    return subprocess.check_output(args, text=True, stderr=subprocess.DEVNULL).strip()


def work_area() -> tuple[int, int, int, int]:
    screen_w, screen_h = map(int, run("xdotool", "getdisplaygeometry").split())
    try:
        desktop = int(re.search(r"=\s*(\d+)", run("xprop", "-root", "_NET_CURRENT_DESKTOP")).group(1))
        values = [
            int(value)
            for value in re.findall(r"-?\d+", run("xprop", "-root", "_NET_WORKAREA"))
        ]
        offset = desktop * 4
        x, y, width, height = values[offset : offset + 4]
        if width > 0 and height > 0:
            return x, y, width, height
    except (subprocess.CalledProcessError, AttributeError, ValueError, IndexError):
        pass
    return 0, 0, screen_w, screen_h


def zones(area: tuple[int, int, int, int]) -> dict[str, tuple[int, int, int, int]]:
    x, y, width, height = area

    usable_w = width - 2 * MARGIN - 2 * GAP
    left_w = round(usable_w * 0.18)
    center_w = round(usable_w * 0.57)
    right_w = usable_w - left_w - center_w
    left_x = x + MARGIN
    center_x = left_x + left_w + GAP
    right_x = center_x + center_w + GAP

    left_inner_h = height - 2 * MARGIN - GAP
    left_top_h = round(left_inner_h / 2)
    left_top_y = y + MARGIN
    left_bottom_y = left_top_y + left_top_h + GAP
    left_bottom_h = left_inner_h - left_top_h

    center_inner_h = height - 2 * MARGIN - 2 * GAP
    top_h = round(center_inner_h * 0.14)
    browser_h = round(center_inner_h * 0.68)
    bottom_h = center_inner_h - top_h - browser_h
    top_y = y + MARGIN
    browser_y = top_y + top_h + GAP
    bottom_y = browser_y + browser_h + GAP

    full_y = y + MARGIN
    full_h = height - 2 * MARGIN

    return {
        "agent-top": (left_x, left_top_y, left_w, left_top_h),
        "agent-bottom": (left_x, left_bottom_y, left_w, left_bottom_h),
        "browser": (center_x, browser_y, center_w, browser_h),
        "chats": (right_x, full_y, right_w, full_h),
        "top": (center_x, top_y, center_w, top_h),
        "bottom": (center_x, bottom_y, center_w, bottom_h),
    }


def frame_extents(window_id: str) -> tuple[int, int, int, int]:
    try:
        output = run("xprop", "-id", window_id, "_NET_FRAME_EXTENTS")
        values = [int(value) for value in re.findall(r"\d+", output.split("=", 1)[1])]
        if len(values) >= 4:
            return tuple(values[:4])  # left, right, top, bottom
    except (subprocess.CalledProcessError, IndexError, ValueError):
        pass
    return 0, 0, 0, 0


def client_geometry(window_id: str) -> tuple[int, int, int, int]:
    """Frame top-left x, y and client width, height: what windowmove/windowsize take."""
    output = run("xwininfo", "-id", window_id)

    def field(label: str) -> int:
        return int(re.search(rf"{label}:\s+(-?\d+)", output).group(1))

    left, _right, top, _bottom = frame_extents(window_id)
    return (
        field("Absolute upper-left X") - left,
        field("Absolute upper-left Y") - top,
        field("Width"),
        field("Height"),
    )


def window_states(window_id: str) -> list[str]:
    try:
        output = run("xprop", "-id", window_id, "_NET_WM_STATE")
    except subprocess.CalledProcessError:
        return []
    return [flag for flag in STATE_FLAGS if f"_NET_WM_STATE_{flag}" in output]


def state_file(window_id: str) -> Path:
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/openbox-zone-{os.getuid()}"
    directory = Path(runtime) / "openbox-zone"
    directory.mkdir(parents=True, exist_ok=True)
    return directory / f"{window_id}.json"


def target_geometry(zone_name: str, window_id: str) -> tuple[int, int, int, int]:
    x, y, width, height = zones(work_area())[zone_name]
    left, right, top, bottom = frame_extents(window_id)
    return x, y, max(1, width - left - right), max(1, height - top - bottom)


def set_states(window_id: str, action: str, flags: list[str]) -> None:
    """Add or remove EWMH window states with wmctrl (xdotool has no windowstate)."""
    if not flags:
        return
    properties = ",".join(flag.lower() for flag in flags)
    subprocess.run(
        ["wmctrl", "-i", "-r", window_id, "-b", f"{action},{properties}"],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def wait_until_states_clear(window_id: str, flags: list[str]) -> None:
    """Openbox applies state changes asynchronously; resizing before they land stalls."""
    for _ in range(20):
        if not any(flag in window_states(window_id) for flag in flags):
            return
        time.sleep(0.05)


def place(window_id: str, geometry: tuple[int, int, int, int]) -> None:
    x, y, client_w, client_h = geometry
    active = window_states(window_id)
    if active:
        set_states(window_id, "remove", active)
        wait_until_states_clear(window_id, active)
    # --sync waits for the window manager; bound it so a refused resize cannot hang.
    for command in (
        ["xdotool", "windowmove", "--sync", window_id, str(x), str(y)],
        ["xdotool", "windowsize", "--sync", window_id, str(client_w), str(client_h)],
    ):
        try:
            subprocess.run(command, check=True, timeout=3)
        except subprocess.TimeoutExpired:
            print(f"openbox-zone: {command[1]} did not complete in time", file=sys.stderr)


def near(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
    return all(abs(p - q) <= TOLERANCE for p, q in zip(a, b))


def toggle(zone_name: str, window_id: str) -> None:
    target = target_geometry(zone_name, window_id)
    saved_path = state_file(window_id)
    current = client_geometry(window_id)
    states = window_states(window_id)

    if saved_path.exists() and not states and near(current, target):
        try:
            saved = json.loads(saved_path.read_text())
            geometry = tuple(int(saved[key]) for key in ("x", "y", "width", "height"))
            flags = [flag for flag in saved["states"] if flag in STATE_FLAGS]
        except (OSError, ValueError, KeyError, TypeError):
            saved_path.unlink(missing_ok=True)
        else:
            saved_path.unlink(missing_ok=True)
            if flags:
                place(window_id, geometry)
                set_states(window_id, "add", flags)
            else:
                place(window_id, geometry)
            return

    saved_path.write_text(
        json.dumps(
            {
                "x": current[0],
                "y": current[1],
                "width": current[2],
                "height": current[3],
                "states": states,
            }
        )
    )
    place(window_id, target)


def main() -> int:
    args = sys.argv[1:]
    if args == ["--list"]:
        print("\n".join(ZONE_NAMES))
        return 0
    do_toggle = bool(args) and args[0] == "toggle"
    names = args[1:] if do_toggle else args
    if len(names) > 1 or (not names and not do_toggle):
        print(USAGE, file=sys.stderr)
        return 2
    name = names[0] if names else DEFAULT_TOGGLE_ZONE
    if name not in ZONE_NAMES:
        print(f"unknown zone: {name}\n{USAGE}", file=sys.stderr)
        return 2

    try:
        window_id = run("xdotool", "getactivewindow")
        if do_toggle:
            toggle(name, window_id)
        else:
            place(window_id, target_geometry(name, window_id))
    except FileNotFoundError as exc:
        print(
            f"openbox-zone: required tool not found ({exc.filename}); "
            "install the xdotool, wmctrl and x11-utils packages",
            file=sys.stderr,
        )
        return 127
    except subprocess.CalledProcessError:
        print("no active window to place", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
