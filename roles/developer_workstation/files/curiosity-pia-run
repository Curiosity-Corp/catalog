# Desktop entries
# ---------------------------------------------------------------------------


def wrap_desktop(text: str, app: str, spec: Mapping[str, object], run_path: str, source: str) -> str:
    """The desktop entry `text` with every Exec= pointed at this launcher."""
    wrapped_commands = set(str_list(spec.get("desktop_commands")))
    out: list[str] = []
    seen_header = False
    exec_lines = 0
    for line in text.splitlines():
        if line.startswith("Exec="):
            match = re.match(r"^Exec=(\S+)(.*)$", line)
            if not match or match.group(1) not in wrapped_commands:
                raise LaunchError(
                    f"{source}: cannot route {line!r} through the launcher; add its command to "
                    f"desktop_commands of {app!r}"
                )
            out.append(f"Exec={run_path} {app}{match.group(2)}")
            exec_lines += 1
            continue
        out.append(line)
        if not seen_header and line.strip() == "[Desktop Entry]":
            seen_header = True
            out.append(MARKER_COMMENT)
            out.append(f"{MARKER_KEY}={app}")
    if not seen_header or exec_lines == 0:
        raise LaunchError(f"{source} is not a launchable desktop entry")
    return "\n".join(out) + "\n"


def marker_app(path: Path) -> str | None:
    """The app a managed file belongs to (desktop key or shim comment), else None."""
    try:
        if path.stat().st_size > 65536:
            return None
        for line in path.read_text().splitlines():
            bare = line.lstrip("# ")
            if bare.startswith(f"{MARKER_KEY}="):
                return bare.split("=", 1)[1].strip()
    except (OSError, UnicodeDecodeError):
        return None
    return None


def shim_text(app: str, run_path: str) -> str:
    return (
        "#!/bin/sh\n"
        f"{MARKER_COMMENT}\n"
        f"# {MARKER_KEY}={app}\n"
        f'exec {run_path} {app} "$@"\n'
    )


def write_file(path: Path, content: str, uid: int | None, gid: int | None, mode: int = 0o644) -> bool:
    try:
        if path.read_text() == content and (path.stat().st_mode & 0o7777) == mode:
            return False
    except (FileNotFoundError, UnicodeDecodeError):
        pass
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(content)
        os.chmod(tmp, mode)
        if uid is not None and gid is not None:
            os.chown(tmp, uid, gid)
        os.replace(tmp, path)
    except OSError:
        Path(tmp).unlink(missing_ok=True)
        raise
    return True


def install_entry(
    target: Path, content: str, uid: int | None, gid: int | None, mode: int = 0o644
) -> list[str]:
    """Write a wrapped entry, keeping a one-time backup of an unmanaged one."""
    changes: list[str] = []
    backup = target.with_name(target.name + BACKUP_SUFFIX)
    if target.exists() and marker_app(target) is None and not backup.exists():
        target.rename(backup)
        changes.append(f"changed: moved aside {target} -> {backup.name}")
    if write_file(target, content, uid, gid, mode):
        changes.append(f"changed: wrote {target}")
    return changes


def remove_entry(target: Path) -> list[str]:
    """Drop a managed entry and restore the unmanaged one it replaced."""
    backup = target.with_name(target.name + BACKUP_SUFFIX)
    changes: list[str] = []
    target.unlink(missing_ok=True)
    changes.append(f"changed: removed {target}")
    if backup.exists():
        backup.rename(target)
        changes.append(f"changed: restored {target}")
    return changes


def installed(spec: Mapping[str, object]) -> bool:
    """Whether the app is on this host: its real command, or a path to be diverted, exists.

    A diverted binary (qbittorrent) is only at its `command` once diverted, so the
    package's own path counts too.
    """
    command = str_list(spec.get("command"))
    return (bool(command) and Path(command[0]).exists()) or any(
        Path(path).exists() for path in str_list(spec.get("diverted"))
    )


def home_owner(home: Path) -> tuple[int | None, int | None]:
    try:
        info = home.stat()
    except OSError:
        return None, None
    return info.st_uid, info.st_gid


def dpkg_divert(args: Sequence[str]) -> str:
    exe = shutil.which("dpkg-divert", path=SAFE_PATH)
    if exe is None:
        raise LaunchError("dpkg-divert is not installed", EXIT_USAGE)
    command = [exe, *(["--admindir", DPKG_ADMINDIR] if DPKG_ADMINDIR else []), *args]
    result = subprocess.run(command, capture_output=True, text=True, check=False)
    if result.returncode != 0:
        raise LaunchError(f"{' '.join(command)} failed: {(result.stderr or result.stdout).strip()}", EXIT_USAGE)
    return result.stdout


DIVERSION_RE = re.compile(r"^diversion of (\S+) to (\S+) by (\S+)$")


def our_diversions() -> set[str]:
    """Paths this launcher has diverted (and so owns the shim on)."""
    found: set[str] = set()
    if shutil.which("dpkg-divert", path=SAFE_PATH) is None:
        return found  # not a dpkg host: nothing can have been diverted
    for line in dpkg_divert(["--list"]).splitlines():
        match = DIVERSION_RE.match(line.strip())
        if match and match.group(3) == DIVERT_PACKAGE:
            found.add(match.group(1))
    return found


def divert_paths(app: str, spec: Mapping[str, object]) -> list[str]:
    paths = str_list(spec.get("diverted"))
    for path in paths:
        if not re.match(r"^/[A-Za-z0-9._/+-]+$", path) or ".." in path.split("/") or path.endswith(DIVERT_SUFFIX):
            raise LaunchError(f"invalid diverted path {path!r} for {app!r}")
    return paths


def legacy_paths(app: str, spec: Mapping[str, object]) -> list[str]:
    paths = str_list(spec.get("legacy_wrappers"))
    for path in paths:
        if not re.match(r"^[A-Za-z0-9._+-][A-Za-z0-9._/+-]*$", path) or ".." in path.split("/"):
            raise LaunchError(f"invalid legacy wrapper path {path!r} for {app!r}")
    return paths


def retire_paths(app: str, spec: Mapping[str, object]) -> list[str]:
    """Home-relative files and user units of hand-made helpers this app's routing replaces."""
    paths = str_list(spec.get("retire_files"))
    for unit in str_list(spec.get("retire_user_units")):
        if not re.match(r"^[A-Za-z0-9][A-Za-z0-9@._-]*\.(?:service|timer)$", unit):
            raise LaunchError(f"invalid retire_user_units entry {unit!r} for {app!r}")
        paths.append(f".config/systemd/user/{unit}")
    for path in paths:
        if not re.match(r"^[A-Za-z0-9._+-][A-Za-z0-9._/+-]*$", path) or ".." in path.split("/"):
            raise LaunchError(f"invalid retire path {path!r} for {app!r}")
    return paths


def retire(home: Path, app: str, spec: Mapping[str, object]) -> list[str]:
    """Move a replaced helper aside (kept as a backup) and drop its enablement links."""
    changes: list[str] = []
    for relative in retire_paths(app, spec):
        path = home / relative
        if path.is_file() and not path.is_symlink() and marker_app(path) is None:
            kind = "unit" if relative.startswith(".config/systemd/user/") else "file"
            backup = path.with_name(path.name + BACKUP_SUFFIX)
            if backup.exists():
                path.unlink()
                changes.append(f"changed: retired {kind} {path} (a backup already exists)")
            else:
                path.rename(backup)
                changes.append(f"changed: retired {kind} {path} -> {backup.name}")
    units_dir = home / ".config/systemd/user"
    for unit in str_list(spec.get("retire_user_units")):
        if units_dir.is_dir():
            for link in sorted(units_dir.glob(f"*.wants/{unit}")):
                if link.is_symlink():
                    link.unlink()
                    changes.append(f"changed: retired unit {unit} (removed {link})")
    return changes


def divert_shim(path: str, app: str, run_path: str) -> list[str]:
    """Move the package's file aside and put the launcher shim at its path."""
    target = Path(path)
    changes: list[str] = []
    if path not in our_diversions():
        if marker_app(target) is not None:
            target.unlink()  # a managed shim without its diversion: start clean
        if not (target.exists() or target.is_symlink()):
            return [f"warning: {path} does not exist, so there is nothing to divert for {app}"]
        dpkg_divert(["--package", DIVERT_PACKAGE, "--add", "--rename", "--divert", path + DIVERT_SUFFIX, path])
        changes.append(f"changed: diverted {path} to {path}{DIVERT_SUFFIX}")
    if write_file(target, shim_text(app, run_path), None, None, 0o755):
        changes.append(f"changed: wrote {target}")
    return changes


def undivert(path: str) -> list[str]:
    """Remove the shim and give the path back to the package."""
    target = Path(path)
    changes: list[str] = []
    if marker_app(target) is not None:
        target.unlink()
        changes.append(f"changed: removed {target}")
    dpkg_divert(["--package", DIVERT_PACKAGE, "--remove", "--rename", path])
    changes.append(f"changed: restored {path} (diversion removed)")
    return changes


def sync(config: Mapping[str, object], homes: Sequence[Path], remove_all: bool) -> list[str]:
    run_path = str(config.get("run_path", "/usr/local/bin/curiosity-pia-run"))
    raw_apps = config.get("apps")
    apps: dict[str, dict[str, object]] = (
        {} if remove_all or not isinstance(raw_apps, dict)
        else {str(k): v for k, v in raw_apps.items() if isinstance(v, dict)}
    )
    wanted: dict[str, str] = {}  # desktop id -> app
    wanted_shims: dict[str, str] = {}  # shim name -> app
    wanted_diverts: dict[str, str] = {}  # absolute path -> app
    for app, spec in apps.items():
        for path in divert_paths(app, spec):
            wanted_diverts[path] = app
        for desktop_id in str_list(spec.get("desktop_ids")):
            wanted[desktop_id] = app
        for shim in str_list(spec.get("shims")):
            wanted_shims[shim] = app
    changes: list[str] = []

    for shim, app in sorted(wanted_shims.items()):
        if not re.match(r"^[A-Za-z0-9][A-Za-z0-9._-]*$", shim):
            raise LaunchError(f"invalid shim name {shim!r} for {app!r}")
        if not installed(apps[app]):
            continue
        changes += install_entry(SHIM_DIR / shim, shim_text(app, run_path), None, None, 0o755)

    for path, app in sorted(wanted_diverts.items()):
        if installed(apps[app]):
            changes += divert_shim(path, app, run_path)

    for app, spec in sorted(apps.items()):
        if not installed(spec):
            continue
        for home in homes:
            uid, gid = home_owner(home)
            for relative in legacy_paths(app, spec):
                legacy = home / relative
                if legacy.is_file() and not legacy.is_symlink():
                    changes += install_entry(legacy, shim_text(app, run_path), uid, gid, 0o755)

    for app, spec in sorted(apps.items()):
        for home in homes:
            changes += retire(home, app, spec)

    for desktop_id, app in sorted(wanted.items()):
        source = next((d / desktop_id for d in SYSTEM_APP_DIRS if (d / desktop_id).is_file()), None)
        if source is None or not installed(apps[app]):
            continue  # the app is not installed; nothing to route
        content = wrap_desktop(source.read_text(), app, apps[app], run_path, str(source))
        changes += install_entry(OVERRIDE_APP_DIR / desktop_id, content, None, None)
        for home in homes:
            override = home / ".local/share/applications" / desktop_id
            if override.exists():
                uid, gid = home_owner(home)
                changes += install_entry(override, content, uid, gid)

    # Prune files this launcher wrote for apps, ids or shims that are no longer configured.
    for path in sorted(our_diversions() - set(wanted_diverts)):
        changes += undivert(path)
    for home in homes:
        local_bin = home / ".local/bin"
        if local_bin.is_dir():
            for entry in sorted(p for p in local_bin.iterdir() if p.is_file() and not p.is_symlink()):
                owner = marker_app(entry)
                if owner is not None and owner not in apps:
                    changes += remove_entry(entry)
    if SHIM_DIR.is_dir():
        for entry in sorted(p for p in SHIM_DIR.iterdir() if p.is_file() and not p.is_symlink()):
            owner = marker_app(entry)
            if owner is not None and wanted_shims.get(entry.name) != owner:
                changes += remove_entry(entry)
    for directory in [OVERRIDE_APP_DIR, *(h / ".local/share/applications" for h in homes)]:
        if not directory.is_dir():
            continue
        for entry in sorted(directory.glob("*.desktop")):
            owner = marker_app(entry)
            if owner is not None and wanted.get(entry.name) != owner:
                changes += remove_entry(entry)
    return changes


def run_sync(argv: Sequence[str]) -> int:
    parser = argparse.ArgumentParser(prog="curiosity-pia-run sync")
    parser.add_argument("--homes", nargs="*", default=[], type=Path)
    parser.add_argument("--remove-all", action="store_true")
    args = parser.parse_args(argv)
    if os.geteuid() != 0 and "CURIOSITY_PIA_ALLOW_NON_ROOT" not in os.environ:
        raise LaunchError("sync must run as root", EXIT_USAGE)
    for line in sync(load_config(), args.homes, args.remove_all):
        print(line)
    return 0


