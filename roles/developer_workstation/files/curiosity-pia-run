#!/usr/bin/python3
# Managed by curiosity.workstation (tasks/pia-tunnel.yml).
"""Run an app inside the fail-closed PIA network namespace.

  curiosity-pia-run APP [ARGS...]      start APP (any name in the configuration)

APP is a key of `apps` in /etc/curiosity/pia-tunnel/config.json. The command it
runs comes from that root-owned file, never from the caller; the caller only
supplies APP and arguments for the app. The launch has two stages:

  user stage   collects the display/session environment, optionally wraps the
               app in a systemd user scope (memory caps), and calls
               `sudo -n curiosity-pia-run --exec ...`.
  root stage   (--exec, reached only through the sudoers rule) checks that the
               namespace exists, refuses when the same app already runs outside
               it, then enters the namespace and drops to the invoking user
               before exec'ing the app. The environment handed to the app is
               rebuilt from an allow-list.

There is no fallback: if sudo, the namespace or the allow-list check fails, the
app is not started at all. Nothing here ever starts the app outside the
namespace.

When the launcher refuses (the namespace is missing, or the app already runs
outside the tunnel) or the tunnel is down, it says so on the user's desktop (a
notification) and in the journal, because a menu launch has no terminal.

Apps with a `port_forward` entry get their listen port from PIA's forwarded
port: the launcher rewrites the app's config before it starts (an app rewrites
its own config on exit, so never while it runs), and `port-sync` does the same
on a timer.

Root-only maintenance commands (run by Ansible and the bind service):
  curiosity-pia-run sync [--remove-all] --homes HOME...
      wrap the desktop entries of every configured app so their Exec= goes
      through this launcher, install a PATH shim for each name in the app's
      `shims`, retire the hand-made files and user units an app lists, and undo
      the wrapping for apps no longer configured.
  curiosity-pia-run port-sync [--homes HOME...]
      write the forwarded port into the config of each `port_forward` app.
"""

from __future__ import annotations

import argparse
import json
import os
import pwd
import re
import shutil
import subprocess
import sys
import syslog
import tempfile
from pathlib import Path
from typing import Callable, Mapping, Sequence

CONFIG_PATH = Path(os.environ.get("CURIOSITY_PIA_CONFIG", "/etc/curiosity/pia-tunnel/config.json"))
NETNS_RUN = Path(os.environ.get("CURIOSITY_PIA_NETNS_RUN", "/run/netns"))
PROC_ROOT = Path(os.environ.get("CURIOSITY_PIA_PROC", "/proc"))
SYSTEM_APP_DIRS = tuple(
    Path(p) for p in os.environ.get("CURIOSITY_PIA_SYSTEM_APP_DIRS", "/usr/share/applications").split(":")
)
OVERRIDE_APP_DIR = Path(os.environ.get("CURIOSITY_PIA_OVERRIDE_APP_DIR", "/usr/local/share/applications"))
SHIM_DIR = Path(os.environ.get("CURIOSITY_PIA_SHIM_DIR", "/usr/local/bin"))
SAFE_PATH = os.environ.get("CURIOSITY_PIA_SAFE_PATH", "/usr/sbin:/usr/bin:/sbin:/bin")
STATE_DIR = Path(os.environ.get("CURIOSITY_PIA_STATE_DIR", "/run/curiosity-pia-tunnel"))
RUNTIME_ROOT = Path(os.environ.get("CURIOSITY_PIA_RUNTIME_ROOT", "/run/user"))

MARKER_KEY = "X-Curiosity-Pia-Tunnel-App"
MARKER_COMMENT = "# Managed by curiosity.workstation (tasks/pia-tunnel.yml). Do not edit."
BACKUP_SUFFIX = ".pre-pia-tunnel"
DIVERT_PACKAGE = "curiosity-pia-tunnel"
DIVERT_SUFFIX = ".distrib"
DPKG_ADMINDIR = os.environ.get("CURIOSITY_PIA_DPKG_ADMINDIR", "")
SCOPE_VALUE_RE = re.compile(r"^(?:infinity|[0-9]+(?:\.[0-9]+)?[KMGT]?|[0-9]{1,3}%)$")

EXIT_USAGE = 2
EXIT_NO_NAMESPACE = 71
EXIT_STRAY = 72

# Names (exact or by prefix) of the session variables an app needs from the
# user's desktop. Everything else is dropped; LD_* and friends never pass.
ENV_EXACT = frozenset(
    {
        "DISPLAY", "XAUTHORITY", "WAYLAND_DISPLAY", "DBUS_SESSION_BUS_ADDRESS",
        "PATH", "LANG", "LANGUAGE", "TZ", "PULSE_SERVER", "PULSE_COOKIE",
        "PULSE_RUNTIME_PATH", "DESKTOP_STARTUP_ID", "SSH_AUTH_SOCK",
    }
)
ENV_PREFIXES = ("LC_", "XDG_", "GTK_", "GDK_", "QT_", "XCURSOR_", "BRAVE_", "CHROME_")
ENV_VALUE_LIMIT = 8192
HELPER_PROCESS_RE = re.compile(rb"(?:^|[\0 ])--type=")
APP_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")


def str_list(value: object) -> list[str]:
    """The string items of a JSON list (anything else is an empty list)."""
    return [item for item in value if isinstance(item, str)] if isinstance(value, list) else []


def app_label(app: str, spec: Mapping[str, object] | None = None) -> str:
    """The name to show a person (`display_name`, else the config key)."""
    name = spec.get("display_name") if spec else None
    return name if isinstance(name, str) and name else app


def quit_hint(app: str, spec: Mapping[str, object]) -> str:
    hint = spec.get("quit_hint")
    return hint if isinstance(hint, str) and hint else f"Quit {app_label(app, spec)} completely"


def log_event(message: str, priority: int = syslog.LOG_INFO) -> None:
    """One line in the journal (as `curiosity-pia-run`); never raises."""
    try:
        syslog.openlog("curiosity-pia-run", 0, syslog.LOG_USER)
        syslog.syslog(priority, message)
        syslog.closelog()
    except OSError:
        return


class LaunchError(Exception):
    """The launch must not proceed; the message is shown to the user."""

    def __init__(self, message: str, code: int = 1) -> None:
        super().__init__(message)
        self.code = code


# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------


def load_config(path: Path | None = None) -> dict[str, object]:
    path = CONFIG_PATH if path is None else path
    try:
        value = json.loads(path.read_text())
    except FileNotFoundError as exc:
        raise LaunchError(f"{path} is missing: the PIA tunnel is not configured on this host", EXIT_USAGE) from exc
    except (OSError, json.JSONDecodeError) as exc:
        raise LaunchError(f"cannot read {path}: {exc}", EXIT_USAGE) from exc
    if not isinstance(value, dict) or not isinstance(value.get("apps"), dict):
        raise LaunchError(f"{path} has no `apps` table", EXIT_USAGE)
    return value


def app_spec(config: Mapping[str, object], app: str) -> dict[str, object]:
    if not APP_NAME_RE.match(app):
        raise LaunchError(f"invalid app name {app!r}", EXIT_USAGE)
    apps = config.get("apps")
    spec = apps.get(app) if isinstance(apps, dict) else None
    if not isinstance(spec, dict):
        known = ", ".join(sorted(apps)) if isinstance(apps, dict) and apps else "none"
        raise LaunchError(f"{app!r} is not routed through PIA on this host (configured: {known})", EXIT_USAGE)
    command = spec.get("command")
    if not (isinstance(command, list) and command and all(isinstance(c, str) and c for c in command)):
        raise LaunchError(f"{app!r} has no command in {CONFIG_PATH}", EXIT_USAGE)
    return spec


def netns_name(config: Mapping[str, object]) -> str:
    name = str(config.get("netns", ""))
    if not re.match(r"^[a-z][a-z0-9_-]{0,14}$", name):
        raise LaunchError(f"invalid network namespace name {name!r} in {CONFIG_PATH}", EXIT_USAGE)
    return name


# ---------------------------------------------------------------------------
# Environment allow-list
# ---------------------------------------------------------------------------


def env_allowed(name: str, extra: Sequence[str] = ()) -> bool:
    return name in ENV_EXACT or name in extra or name.startswith(ENV_PREFIXES)


def collect_env(environ: Mapping[str, str], extra: Sequence[str] = ()) -> dict[str, str]:
    """The variables worth passing from the caller's session."""
    return {
        name: value
        for name, value in environ.items()
        if env_allowed(name, extra) and "\0" not in value and len(value) <= ENV_VALUE_LIMIT
    }


def parse_env_pairs(pairs: Sequence[str], extra: Sequence[str] = ()) -> dict[str, str]:
    """Validate NAME=VALUE pairs received on the root stage's command line."""
    result: dict[str, str] = {}
    for pair in pairs:
        name, sep, value = pair.partition("=")
        if not sep or not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", name):
            raise LaunchError(f"malformed environment entry {name!r}", EXIT_USAGE)
        if not env_allowed(name, extra):
            raise LaunchError(f"environment variable {name} is not allowed through the PIA launcher", EXIT_USAGE)
        if "\0" in value or len(value) > ENV_VALUE_LIMIT:
            raise LaunchError(f"environment variable {name} has an invalid value", EXIT_USAGE)
        result[name] = value
    return result


# ---------------------------------------------------------------------------
# User stage
# ---------------------------------------------------------------------------


def scope_properties(spec: Mapping[str, object], environ: Mapping[str, str] | None = None) -> list[str]:
    """systemd-run arguments for the app's optional memory-capped user scope.

    `scope_env` maps a property to an environment variable the caller may use to
    change that limit for one launch (the old brave-capped wrapper honoured
    BRAVE_MEMORY_HIGH and BRAVE_MEMORY_MAX). It is the caller's own cgroup.
    """
    scope = spec.get("scope")
    if not isinstance(scope, dict) or not scope:
        return []
    overrides = spec.get("scope_env")
    env_names = {str(k): str(v) for k, v in overrides.items()} if isinstance(overrides, dict) else {}
    args = ["--user", "--scope", "--quiet", "--collect"]
    slice_name = scope.get("slice")
    if isinstance(slice_name, str) and slice_name:
        args.append(f"--slice={slice_name}")
    for key, value in scope.items():
        if key == "slice":
            continue
        override = (environ or {}).get(env_names.get(str(key), ""), "")
        if override:
            if not SCOPE_VALUE_RE.match(override):
                raise LaunchError(
                    f"{env_names[str(key)]}={override!r} is not a valid {key} (for example 8G, 50% or infinity)",
                    EXIT_USAGE,
                )
            value = override
        args += ["-p", f"{key}={value}"]
    return args


def user_stage_command(
    config: Mapping[str, object],
    app: str,
    args: Sequence[str],
    environ: Mapping[str, str],
    scope_available: bool,
) -> list[str]:
    spec = app_spec(config, app)
    extra = str_list(spec.get("env_passthrough"))
    run_path = str(config.get("run_path", "/usr/local/bin/curiosity-pia-run"))
    inner = ["sudo", "-n", run_path, "--exec", app]
    for name, value in sorted(collect_env(environ, extra).items()):
        inner += ["--env", f"{name}={value}"]
    inner += ["--", *args]
    props = scope_properties(spec, environ)
    if props and scope_available:
        return ["systemd-run", *props, "--", *inner]
    return inner


def systemd_user_available() -> bool:
    if shutil.which("systemd-run") is None or shutil.which("systemctl") is None:
        return False
    return (
        subprocess.run(
            ["systemctl", "--user", "show-environment"],
            capture_output=True,
            check=False,
        ).returncode
        == 0
    )


def run_user(app: str, args: Sequence[str]) -> int:
    config = load_config()
    prepare_app_for_launch(config, app)
    command = user_stage_command(config, app, args, os.environ, systemd_user_available())
    try:
        os.execvp(command[0], command)
    except FileNotFoundError as exc:
        raise LaunchError(f"{command[0]} is not installed; refusing to start {app} outside the tunnel") from exc
    return 1  # unreachable


# ---------------------------------------------------------------------------
# Root stage
# ---------------------------------------------------------------------------


def main_processes(guard_exe: str, uid: int) -> list[tuple[int, int]]:
    """(pid, network namespace inode) of the main processes of `guard_exe` owned by `uid`."""
    found: list[tuple[int, int]] = []
    for entry in sorted(PROC_ROOT.iterdir(), key=lambda p: p.name):
        if not entry.name.isdigit():
            continue
        try:
            if entry.stat().st_uid != uid:
                continue
            exe = os.readlink(entry / "exe").removesuffix(" (deleted)")
            if exe != guard_exe:
                continue
            # Chromium rewrites a child's argv with spaces for NULs, so match
            # `--type=` as a word in the raw bytes rather than as a list item.
            if HELPER_PROCESS_RE.search((entry / "cmdline").read_bytes()):
                continue  # a helper process; the main process decides
            found.append((int(entry.name), (entry / "ns" / "net").stat().st_ino))
        except (OSError, ValueError):
            continue  # the process exited, or is not ours to inspect
    return found


def find_strays(guard_exe: str, uid: int, tunnel_ns_inode: int) -> list[int]:
    """Main processes of `guard_exe` owned by `uid` that run outside the tunnel."""
    return [pid for pid, inode in main_processes(guard_exe, uid) if inode != tunnel_ns_inode]


def notify_user(uid: int, gid: int, env: Mapping[str, str], message: str) -> None:
    """Best-effort desktop notification as the user; never blocks the launch result."""
    notify = shutil.which("notify-send", path=SAFE_PATH)
    setpriv = shutil.which("setpriv", path=SAFE_PATH)
    if not notify or not setpriv:
        return
    clean = {k: v for k, v in env.items() if k in ("DISPLAY", "XAUTHORITY", "DBUS_SESSION_BUS_ADDRESS", "XDG_RUNTIME_DIR")}
    try:
        subprocess.run(
            [setpriv, f"--reuid={uid}", f"--regid={gid}", "--init-groups", "--",
             notify, "--urgency=critical", "--app-name=PIA tunnel", "PIA tunnel", message],
            env=clean,
            capture_output=True,
            timeout=10,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return


def tunnel_interface_present(ns: str, interface: str) -> bool | None:
    """Whether the tunnel interface exists in the namespace; None when that cannot be told."""
    ip = shutil.which("ip", path=SAFE_PATH)
    if not ip:
        return None
    try:
        result = subprocess.run(
            [ip, "-n", ns, "link", "show", interface], capture_output=True, timeout=10, check=False
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    return result.returncode == 0


def refuse(uid: int, gid: int, env: Mapping[str, str], notice: str, detail: str, code: int) -> LaunchError:
    """Tell the person (desktop notice) and the journal, then return the error to raise."""
    notify_user(uid, gid, env, notice)
    log_event(f"refused: {detail}", syslog.LOG_WARNING)
    return LaunchError(detail, code)


def root_stage_command(
    config: Mapping[str, object],
    app: str,
    env_pairs: Sequence[str],
    args: Sequence[str],
    uid: int,
    gid: int,
    home: str,
    login: str,
    shell: str,
) -> list[str]:
    """The argv that enters the namespace, drops to the user and starts the app."""
    spec = app_spec(config, app)
    ns = netns_name(config)
    extra = str_list(spec.get("env_passthrough"))
    passed = parse_env_pairs(env_pairs, extra)
    base = {"HOME": home, "USER": login, "LOGNAME": login, "SHELL": shell}
    environment = {**{"PATH": "/usr/local/bin:/usr/bin:/bin"}, **passed, **base}
    ip = shutil.which("ip", path=SAFE_PATH)
    setpriv = shutil.which("setpriv", path=SAFE_PATH)
    env_bin = shutil.which("env", path=SAFE_PATH)
    if not (ip and setpriv and env_bin):
        raise LaunchError("ip, setpriv and env are required to enter the PIA namespace")
    command = str_list(spec.get("command"))
    assignments = [f"{k}={v}" for k, v in sorted(environment.items())]
    return [
        ip, "netns", "exec", ns,
        setpriv, f"--reuid={uid}", f"--regid={gid}", "--init-groups", "--",
        env_bin, "-i", *assignments, *command, *args,
    ]


def run_root(app: str, env_pairs: Sequence[str], args: Sequence[str]) -> int:
    if os.geteuid() != 0:
        raise LaunchError("--exec is the privileged stage; start apps with `curiosity-pia-run APP`", EXIT_USAGE)
    try:
        uid = int(os.environ["SUDO_UID"])
        gid = int(os.environ["SUDO_GID"])
    except (KeyError, ValueError) as exc:
        raise LaunchError("--exec must be reached through sudo", EXIT_USAGE) from exc
    if uid == 0:
        raise LaunchError("refusing to start an app as root inside the PIA namespace", EXIT_USAGE)
    try:
        account = pwd.getpwuid(uid)
    except KeyError as exc:
        raise LaunchError(f"uid {uid} has no account", EXIT_USAGE) from exc

    config = load_config()
    spec = app_spec(config, app)
    real = str_list(spec.get("command"))[0]
    if marker_app(Path(real)) is not None:
        # The shim for this app sits on the path its own command names: running it
        # would call this launcher again, forever.
        raise LaunchError(f"{real} is a PIA shim, not the real {app} command; fix `command` in {CONFIG_PATH}", EXIT_USAGE)
    ns = netns_name(config)
    label = app_label(app, spec)
    passed = parse_env_pairs(env_pairs, str_list(spec.get("env_passthrough")))

    netns_file = NETNS_RUN / ns
    try:
        ns_inode = netns_file.stat().st_ino
    except FileNotFoundError:
        raise refuse(
            uid, gid, passed,
            f"The PIA tunnel is down, so {label} was not started. It would run without the VPN otherwise.",
            f"The PIA network namespace '{ns}' does not exist, so {app} was not started "
            "(it would otherwise run without the VPN). Start curiosity-pia-tunnel.service.",
            EXIT_NO_NAMESPACE,
        ) from None

    guard = spec.get("guard_exe")
    if isinstance(guard, str) and guard:
        strays = find_strays(guard, uid, ns_inode)
        if strays:
            raise refuse(
                uid, gid, passed,
                f"{label} is already open without the VPN. {quit_hint(app, spec)} and open it again to use PIA.",
                f"{app} is already running OUTSIDE the PIA tunnel (pid {', '.join(map(str, strays))}). "
                "Quit it completely and start it again so it runs through the VPN.",
                EXIT_STRAY,
            )

    interface = config.get("interface")
    if isinstance(interface, str) and tunnel_interface_present(ns, interface) is False:
        # Fail-closed: the app starts, but has no network until the tunnel is back.
        notify_user(uid, gid, passed, f"The PIA tunnel is down; {label} stays offline until it reconnects.")
        log_event(f"{app} started while the tunnel interface {interface} is down; it has no network", syslog.LOG_WARNING)

    command = root_stage_command(
        config, app, env_pairs, args, uid, gid, account.pw_dir, account.pw_name, account.pw_shell
    )
    os.execv(command[0], command)
    return 1  # unreachable


# ---------------------------------------------------------------------------
# Forwarded port -> app config
# ---------------------------------------------------------------------------

SECTION_RE = re.compile(r"^\[(.+)\]\s*$")
# Keys that bind an app to a named interface or address. Inside the namespace the
# only interface is the tunnel (and it is rebuilt with a new index), so a binding
# to the old PIA app's interface would leave the app with no listen socket at all.
QBT_BINDING_KEYS = {
    "BitTorrent": ("Session\\Interface", "Session\\InterfaceName", "Session\\InterfaceAddress"),
    "Preferences": ("Connection\\Interface", "Connection\\InterfaceName", "Connection\\InterfaceAddress"),
}
QBT_PORT_KEYS = {"BitTorrent": "Session\\Port", "Preferences": "Connection\\PortRangeMin"}
NOTIFIED_FILE = "port-sync-notified.json"


def read_forwarded_port() -> int | None:
    """The port PIA has bound for the tunnel, None when there is none (tunnel down or unbound)."""
    try:
        value = int((STATE_DIR / "forwarded-port").read_text().strip())
    except (FileNotFoundError, ValueError, OSError):
        return None
    return value if 1024 <= value <= 65535 else None


def ini_set(lines: list[str], section: str, key: str, value: str, create: bool) -> bool:
    """Set `key=value` inside `[section]`; True when `lines` changed. Without `create` only an existing key is touched."""
    start = end = None
    for index, line in enumerate(lines):
        match = SECTION_RE.match(line)
        if match:
            if start is not None and end is None:
                end = index
            if match.group(1) == section and start is None:
                start = index
    if start is not None and end is None:
        end = len(lines)
    if start is not None and end is not None:
        for index in range(start + 1, end):
            if lines[index].startswith(f"{key}="):
                if lines[index] == f"{key}={value}":
                    return False
                lines[index] = f"{key}={value}"
                return True
    if not create:
        return False
    if start is None:
        while lines and lines[-1] == "":
            lines.pop()
        lines += ["", f"[{section}]", f"{key}={value}", ""]
        return True
    assert end is not None
    position = end
    while position > start + 1 and lines[position - 1].strip() == "":
        position -= 1
    lines.insert(position, f"{key}={value}")
    return True


def qbittorrent_config(text: str, port: int | None) -> str:
    """qBittorrent.conf with the forwarded port set and interface bindings cleared."""
    lines = text.split("\n")
    for section, keys in QBT_BINDING_KEYS.items():
        for key in keys:
            ini_set(lines, section, key, "", create=False)
    for index, line in enumerate(lines):
        key, sep, value = line.partition("=")
        if sep and key.endswith("UseRandomPort") and value.strip().lower() == "true":
            lines[index] = f"{key}=false"
    if port is not None:
        for section, key in QBT_PORT_KEYS.items():
            ini_set(lines, section, key, str(port), create=True)
    return "\n".join(lines)


def qbittorrent_port(text: str) -> str | None:
    in_section = False
    for line in text.split("\n"):
        match = SECTION_RE.match(line)
        if match:
            in_section = match.group(1) == "BitTorrent"
        elif in_section and line.startswith(f"{QBT_PORT_KEYS['BitTorrent']}="):
            return line.split("=", 1)[1].strip()
    return None


def port_forward_config(app: str, spec: Mapping[str, object]) -> str | None:
    """The app's config path relative to the home, when the app takes the forwarded port."""
    entry = spec.get("port_forward")
    relative = entry.get("config") if isinstance(entry, dict) else None
    if relative is None:
        return None
    if not (isinstance(relative, str) and re.match(r"^[A-Za-z0-9._+-][A-Za-z0-9._/+-]*$", relative)
            and ".." not in relative.split("/")):
        raise LaunchError(f"invalid port_forward config path {relative!r} for {app!r}")
    return relative


def write_config(conf: Path, text: str) -> None:
    """Replace `conf` atomically, keeping its mode and owner (and backing up the original once)."""
    real = conf.resolve()
    info = real.stat()
    backup = real.with_name(real.name + BACKUP_SUFFIX)
    if not backup.exists():
        shutil.copy2(real, backup)
    fd, tmp = tempfile.mkstemp(dir=real.parent, prefix=f".{real.name}.")
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(text)
        os.chmod(tmp, info.st_mode & 0o7777)
        if os.geteuid() == 0:
            os.chown(tmp, info.st_uid, info.st_gid)
        os.replace(tmp, real)
    except OSError:
        Path(tmp).unlink(missing_ok=True)
        raise


def sync_app_port(
    app: str,
    spec: Mapping[str, object],
    home: Path,
    uid: int,
    port: int | None,
    on_running: Callable[[int], None] | None = None,
) -> list[str]:
    """Bring one home's config for `app` in line with the forwarded port; returns log lines."""
    relative = port_forward_config(app, spec)
    if relative is None:
        return []
    conf = home / relative
    try:
        text = conf.read_text()
    except FileNotFoundError:
        return []  # the app has not run yet; the launcher prepares it on first launch
    except (OSError, UnicodeDecodeError) as exc:
        return [f"warning: cannot read {conf}: {exc}"]
    wanted = qbittorrent_config(text, port)
    if wanted == text:
        return [f"unchanged: {app} listens on {port} for {home.name}"] if port else []
    guard = spec.get("guard_exe")
    if isinstance(guard, str) and guard and main_processes(guard, uid):
        # The running app would overwrite the file when it quits; never edit it underneath.
        if port is not None and on_running is not None:
            on_running(port)
        return [f"deferred: {app} is running, so {conf} keeps its port until it is restarted (forwarded port {port})"]
    old = qbittorrent_port(text)
    try:
        write_config(conf, wanted)
    except OSError as exc:
        return [f"warning: cannot update {conf}: {exc}"]
    if port is None:
        return [f"changed: cleared the interface bindings in {conf}"]
    return [f"changed: {app} listen port {old or 'unset'} -> {port} in {conf}"]


def prepare_app_for_launch(config: Mapping[str, object], app: str) -> None:
    """User stage: update the app's own config before it starts; failures never block the launch."""
    spec = app_spec(config, app)
    try:
        if port_forward_config(app, spec) is None:
            return
        account = pwd.getpwuid(os.getuid())
        lines = sync_app_port(app, spec, Path(account.pw_dir), os.getuid(), read_forwarded_port())
    except (LaunchError, KeyError, OSError) as exc:
        log_event(f"cannot prepare {app} for launch: {exc}", syslog.LOG_WARNING)
        return
    for line in lines:
        log_event(line, syslog.LOG_NOTICE if line.startswith("changed") else syslog.LOG_INFO)


def notified_before(uid: int, app: str, port: int) -> bool:
    try:
        recorded = json.loads((STATE_DIR / NOTIFIED_FILE).read_text())
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return False
    return isinstance(recorded, dict) and recorded.get(f"{uid}:{app}") == port


def remember_notified(uid: int, app: str, port: int) -> None:
    path = STATE_DIR / NOTIFIED_FILE
    try:
        recorded = json.loads(path.read_text())
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        recorded = {}
    if not isinstance(recorded, dict):
        recorded = {}
    recorded[f"{uid}:{app}"] = port
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(recorded))
    except OSError as exc:
        log_event(f"cannot record the port notice: {exc}", syslog.LOG_WARNING)


def port_sync(config: Mapping[str, object], homes: Sequence[Path]) -> list[str]:
    """Root: write the forwarded port into every port_forward app's config, once per change."""
    port = read_forwarded_port()
    raw_apps = config.get("apps")
    apps = {str(k): v for k, v in raw_apps.items() if isinstance(v, dict)} if isinstance(raw_apps, dict) else {}
    lines: list[str] = []
    if port is None:
        lines.append("no forwarded port is bound; the apps keep the port they have")
    for app, spec in sorted(apps.items()):
        if port_forward_config(app, spec) is None:
            continue
        for home in homes:
            uid, gid = home_owner(home)
            if uid is None or gid is None:
                continue

            def tell(bound: int, uid: int = uid, gid: int = gid, app: str = app, spec: Mapping[str, object] = spec) -> None:
                if notified_before(uid, app, bound):
                    return
                bus = RUNTIME_ROOT / str(uid) / "bus"
                if bus.exists():
                    notify_user(
                        uid, gid,
                        {"XDG_RUNTIME_DIR": str(RUNTIME_ROOT / str(uid)), "DBUS_SESSION_BUS_ADDRESS": f"unix:path={bus}"},
                        f"PIA gave {app_label(app, spec)} a new port ({bound}). "
                        f"{quit_hint(app, spec)} and open it again to use it.",
                    )
                remember_notified(uid, app, bound)

            lines += sync_app_port(app, spec, home, uid, port, tell)
    return lines


def run_port_sync(argv: Sequence[str]) -> int:
    parser = argparse.ArgumentParser(prog="curiosity-pia-run port-sync")
    parser.add_argument("--homes", nargs="*", type=Path, default=None)
    args = parser.parse_args(argv)
    if os.geteuid() != 0 and "CURIOSITY_PIA_ALLOW_NON_ROOT" not in os.environ:
        raise LaunchError("port-sync must run as root", EXIT_USAGE)
    config = load_config()
    homes = args.homes if args.homes is not None else [Path(h) for h in str_list(config.get("homes"))]
    for line in port_sync(config, homes):
        print(line, flush=True)
        log_event(line, syslog.LOG_NOTICE if line.startswith("changed") else syslog.LOG_INFO)
    return 0


