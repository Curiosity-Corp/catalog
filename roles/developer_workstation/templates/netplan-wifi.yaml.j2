# Managed by Ansible (developer_workstation: wifi-netplan.yml). Do not edit.
network:
  version: 2
  wifis:
    wifi-{{ wifi_netplan_name }}:
      renderer: NetworkManager
      match:
        name: "{{ wifi_netplan_match }}"
      dhcp4: true
      dhcp6: true
      access-points:
        "{{ wifi_ssid }}":
          auth:
            key-management: "psk"
            password: "{{ wifi_psk }}"
          networkmanager:
            uuid: "{{ wifi_nm_uuid }}"
            name: "{{ wifi_ssid }}"
            passthrough:
              wifi-security.auth-alg: "open"
      networkmanager:
        uuid: "{{ wifi_nm_uuid }}"
        name: "{{ wifi_ssid }}"
