#!/bin/sh
# Git credential helper for a remote workspace service (docs/workspace-providers.md).
# Managed by the developer_workstation role; installed only when
# workspace_git_auth_helper_enabled is true.
#
# git runs it as `git-credential-workspace get|store|erase` for
# https://{{ workspace_git_host }}. On `get` it asks the workspace service for a
# short-lived token, at request time, with
#   <workspace_external_auth_binary> external-auth access-token <workspace_external_auth_provider>
# and hands it to git. No token is written to disk. When no token can be had,
# it says why on stderr and exits 1, without printing the token or anything the
# token command wrote; git then tries its next credential source.
set -u

helper=git-credential-workspace
auth_command={{ workspace_external_auth_binary | quote }}
provider={{ workspace_external_auth_provider | quote }}
host={{ workspace_git_host | quote }}
username={{ workspace_git_auth_username | quote }}

fail() {
    printf '%s: cannot get a token for %s: %s\n' "$helper" "$host" "$*" >&2
    exit 1
}

# git writes the request (protocol, host, ...) on stdin; the helper is wired to
# one host, so it only drains it.
cat >/dev/null

case "${1:-}" in
    get) ;;
    # store and erase: tokens are minted fresh for every request, nothing is kept.
    *) exit 0 ;;
esac

command -v "$auth_command" >/dev/null 2>&1 ||
    fail "$auth_command is not installed or not on PATH. Install the workspace service's command-line client, or clone over SSH (docs/workspace-providers.md)."

# The command's stderr is dropped and its stdout kept in a variable: neither
# ever reaches the terminal, so a token cannot leak through an error path.
status=0
token=$("$auth_command" external-auth access-token "$provider" </dev/null 2>/dev/null) || status=$?
if [ "$status" -ne 0 ]; then
    token=
    fail "'$auth_command external-auth access-token $provider' failed (exit status $status). Sign in to the workspace service and connect your $provider account there, then try again."
fi
if [ -z "$token" ]; then
    fail "'$auth_command external-auth access-token $provider' printed no token. Connect your $provider account in the workspace service, then try again."
fi
case "$token" in
    *[![:graph:]]*)
        token=
        fail "'$auth_command external-auth access-token $provider' printed something other than a single token (it has spaces, line breaks or control characters), so nothing was passed to git. Its output is not shown."
        ;;
esac

printf 'username=%s\npassword=%s\n' "$username" "$token"
