<?xml version="1.0" encoding="UTF-8"?>
<!-- Managed by Curiosity-Corp/catalog (developer_workstation, minimal-desktop-openbox.yml). -->

<openbox_menu xmlns="http://openbox.org/3.4/menu">

<menu id="apps-menu" label="Applications">
  <item label="Firefox">
    <action name="Execute"><command>firefox</command></action>
  </item>
  <item label="Terminal">
    <action name="Execute"><command>lxterminal</command></action>
  </item>
  <item label="File Manager">
    <action name="Execute"><command>pcmanfm</command></action>
  </item>
  <item label="App Launcher">
    <action name="Execute"><command>rofi -show drun -show-icons</command></action>
  </item>
{% set _jellyfin_menu = jellyfin_desktop_enabled | default(false) | bool and ansible_architecture | default('') == 'x86_64' %}
{% if media_folder_enabled | default(false) | bool %}
  <menu id="media-menu" label="{{ media_folder_name | e }}">
{% if _jellyfin_menu %}
    <item label="Jellyfin Desktop">
      <action name="Execute"><command>flatpak run {{ jellyfin_desktop_flatpak_id }}</command></action>
    </item>
{% endif %}
{% for entry in media_folder_web_entries %}
    <item label="{{ entry.name | e }}">
      <action name="Execute"><command>xdg-open {{ entry.url | e }}</command></action>
    </item>
{% endfor %}
  </menu>
{% elif _jellyfin_menu %}
  <separator label="Media" />
  <item label="Jellyfin Desktop">
    <action name="Execute"><command>flatpak run {{ jellyfin_desktop_flatpak_id }}</command></action>
  </item>
  <item label="Jellyfin (web)">
    <action name="Execute"><command>xdg-open {{ jellyfin_web_url }}</command></action>
  </item>
{% endif %}
</menu>

<menu id="system-menu" label="System">
  <item label="Appearance">
    <action name="Execute"><command>lxappearance</command></action>
  </item>
  <item label="Wallpaper">
    <action name="Execute"><command>sh -c 'feh --thumbnails --scale-down --title "Wallpaper: press 1 to apply" --action1 "feh --bg-fill %F" "$HOME/Pictures"'</command></action>
  </item>
  <item label="Reconfigure Openbox">
    <action name="Execute"><command>openbox --reconfigure</command></action>
  </item>
</menu>

<menu id="root-menu" label="Openbox">
  <separator label="Quick Launch" />
  <item label="Firefox">
    <action name="Execute"><command>firefox</command></action>
  </item>
  <item label="Terminal">
    <action name="Execute"><command>lxterminal</command></action>
  </item>
  <item label="File Manager">
    <action name="Execute"><command>pcmanfm</command></action>
  </item>
  <item label="App Launcher (Rofi)">
    <action name="Execute"><command>rofi -show drun -show-icons</command></action>
  </item>
  <separator />
  <menu id="apps-menu" />
  <menu id="system-menu" />
  <separator />
  <item label="Log Out">
    <action name="SessionLogout">
      <prompt>yes</prompt>
    </action>
  </item>
</menu>

</openbox_menu>
