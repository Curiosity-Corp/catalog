#!/usr/bin/env bash
# Git credential helper for Coder workspaces.
#
# Mints a fresh OAuth token from Coder's external-auth integration at request
# time. No long-lived personal access token is written to disk.
set -eu

case ${1:-} in
    get)
        command -v coder >/dev/null || exit 0
        token=$(coder external-auth access-token "{{ workspace_gitlab_external_auth_provider }}" 2>/dev/null) || exit 0
        [ -n "$token" ] || exit 0
        printf 'username=oauth2\npassword=%s\n' "$token"
        ;;
    *)
        # store / erase are no-ops; the token is minted fresh by Coder.
        :
        ;;
esac
