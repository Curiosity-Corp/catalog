# Managed by Ansible — do not edit manually.
# Replaces the package-owned /etc/logrotate.d/ziti-tunnel (diverted to .dpkg-dist).
# Tighter maxsize cap to prevent ziti debug floods from consuming disk.
/var/log/ziti-tunnel.log
/tmp/ziti-tunnel.log
{
    su root root
    daily
    rotate 3
    maxsize {{ logrotate_ziti_maxsize }}
    missingok
    notifempty
    compress
    copytruncate
}
