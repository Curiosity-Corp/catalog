# Managed by curiosity.workstation. Host-local: these names come from this
# host's own variables (ziti_etc_hosts_pins), never from the public defaults.
# Read by curiosity-ziti-pins.service and by `curiosity-ziti-pins check`:
#   set -a; . {{ ziti_pin_env_path }}; set +a; {{ ziti_pin_script_path }} check
ZITI_PINS_HOSTS={{ ziti_etc_hosts_pins | join(',') }}
ZITI_PINS_RESOLVER={{ ziti_pin_resolver }}
