# Managed by Ansible (developer_workstation, tasks/hhtest.yml). Caps the whole
# user-{{ hhtest_uid }}.slice so test runs cannot starve other users' sessions:
# a dedicated tail range of cores, a low CPU weight and a matching quota
# (hypervoid/hyperharness#885).
[Slice]
MemoryAccounting=yes
CPUAccounting=yes
TasksAccounting=yes
MemoryMax={{ hhtest_memory_max }}
MemoryHigh={{ hhtest_memory_high }}
CPUQuota={{ hhtest_cpu_quota }}
CPUWeight={{ hhtest_cpu_weight }}
{% if hhtest_allowed_cpus | trim | length > 0 %}
AllowedCPUs={{ hhtest_allowed_cpus | trim }}
{% endif %}
TasksMax={{ hhtest_tasks_max }}
