# {{ ansible_managed }}
HH_DATA_MOUNT={{ workstation_storage_data_mount }}
HH_HOME_USERS="{{ workstation_storage_users | map(attribute='name') | join(' ') }}"
HH_FS_UUID={{ workstation_storage_fs_uuid }}
HH_LUKS_UUID={{ workstation_storage_luks_uuid }}
HH_MAPPER={{ workstation_storage_mapper }}
HH_STATE=/var/lib/hh-storage
HH_MARKER=/var/lib/hh-storage/cutover-complete
HH_SNAPSHOT_DIR={{ workstation_storage_data_mount }}/@snapshots
HH_SOAK_DAYS={{ workstation_storage_soak_days }}
