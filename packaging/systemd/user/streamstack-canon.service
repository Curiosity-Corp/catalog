# Canon live view -> loopback camera (`streamstack canon-bridge`).
[Unit]
Description=StreamStack Canon live view bridge (loopback camera)
After=pipewire.service wireplumber.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStart=streamstack canon-bridge
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=15
NoNewPrivileges=true

[Install]
WantedBy=default.target
